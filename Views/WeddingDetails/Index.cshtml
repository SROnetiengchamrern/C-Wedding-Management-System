@model IEnumerable<WeddingManagementSystem.Models.Wedding>
@{
    ViewData["Title"] = "Couples";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Couples</h1>
        <p class="page-lead">Core wedding details for each couple — names, date, and venue.</p>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="info-banner">@ok</div>
}

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Web ID</th>
                <th>Couple</th>
                <th>Date</th>
                <th>Venue</th>
                <th>Location</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var w in Model)
        {
            <tr>
                <td>@w.WebId</td>
                <td><strong>@w.CoupleDisplayName</strong></td>
                <td>@w.WeddingDate.ToString("MMM d, yyyy")</td>
                <td>@(w.VenueName ?? "—")</td>
                <td>@(w.VenueLocation ?? "—")</td>
                <td class="actions">
                    <a class="btn-outline btn-sm" asp-action="Edit" asp-route-id="@w.Id">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
