@model WeddingManagementSystem.Models.MenuItem
@{
    ViewData["Title"] = "Add dish";
}

<h1 class="page-title">Add dish</h1>
<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" required />
        </div>
        <div class="form-group">
            <label asp-for="Course"></label>
            <select asp-for="Course">
                <option>Starter</option>
                <option>Main</option>
                <option>Side</option>
                <option>Dessert</option>
                <option>Drink</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="2"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="DietaryNotes">Dietary notes</label>
            <input asp-for="DietaryNotes" />
        </div>
        <div class="form-group">
            <label asp-for="PricePerGuest">Price per guest</label>
            <input asp-for="PricePerGuest" type="number" step="0.01" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-gold">Save</button>
            <a class="btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
