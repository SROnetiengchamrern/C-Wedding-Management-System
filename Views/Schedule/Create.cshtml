@model WeddingManagementSystem.Models.ScheduleItem
@{
    ViewData["Title"] = "Add schedule item";
}

<h1 class="page-title">Add schedule item</h1>
<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" required />
        </div>
        <div class="form-group">
            <label asp-for="StartTime">Start time</label>
            <input asp-for="StartTime" type="time" />
        </div>
        <div class="form-group">
            <label asp-for="EndTime">End time</label>
            <input asp-for="EndTime" type="time" />
        </div>
        <div class="form-group">
            <label asp-for="Location"></label>
            <input asp-for="Location" />
        </div>
        <div class="form-group">
            <label asp-for="Notes"></label>
            <textarea asp-for="Notes" rows="2"></textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-gold">Save</button>
            <a class="btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
