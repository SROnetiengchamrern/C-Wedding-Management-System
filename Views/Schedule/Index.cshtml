@model List<WeddingManagementSystem.Models.ScheduleItem>
@{
    ViewData["Title"] = "Day of Schedule";
    var weddingDate = ViewBag.WeddingDate as DateTime?;
}

<div class="toolbar">
    <div>
        <h1 class="page-title">Day of Schedule</h1>
        @if (weddingDate.HasValue)
        {
            <p class="muted" style="margin:0;">@weddingDate.Value.ToString("dddd, MMM d, yyyy")</p>
        }
    </div>
    <a class="btn-gold" asp-action="Create">Add time block</a>
</div>

<div class="schedule-list">
@foreach (var s in Model)
{
    <div class="schedule-row panel">
        <div class="schedule-time">
            <strong>@s.StartTime.ToString(@"hh\:mm")</strong>
            @if (s.EndTime.HasValue)
            {
                <span class="muted">– @s.EndTime.Value.ToString(@"hh\:mm")</span>
            }
        </div>
        <div class="schedule-body">
            <h3>@s.Title</h3>
            @if (!string.IsNullOrWhiteSpace(s.Location))
            {
                <div class="muted">@s.Location</div>
            }
            @if (!string.IsNullOrWhiteSpace(s.Notes))
            {
                <div class="muted sm-text">@s.Notes</div>
            }
        </div>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@s.Id" />
            <button type="submit" class="btn-ghost">Remove</button>
        </form>
    </div>
}
</div>
