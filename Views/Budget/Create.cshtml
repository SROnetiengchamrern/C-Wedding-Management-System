@using WeddingManagementSystem.Models
@model Payment
@{
    ViewData["Title"] = "Add payment";
}

<h1 class="page-title">Add payment</h1>
<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Description"></label>
            <input asp-for="Description" required />
        </div>
        <div class="form-group">
            <label asp-for="VendorId">Vendor</label>
            <select asp-for="VendorId" asp-items="ViewBag.Vendors">
                <option value="">— None —</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Amount"></label>
            <input asp-for="Amount" type="number" step="0.01" required />
        </div>
        <div class="form-group">
            <label asp-for="DueDate">Due date</label>
            <input asp-for="DueDate" type="date" />
        </div>
        <div class="form-group">
            <label asp-for="Status"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<PaymentStatus>()"></select>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-gold">Save</button>
            <a class="btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
