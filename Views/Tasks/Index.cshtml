@using WeddingManagementSystem.Models
@model List<WeddingTask>
@{
    ViewData["Title"] = "Tasks";
}

<div class="toolbar">
    <h1 class="page-title">Tasks</h1>
    <a class="btn-gold" asp-action="Create">Add task</a>
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th>Task</th>
                <th>Due</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>
                    <strong>@t.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(t.Description))
                    {
                        <div class="muted sm-text">@t.Description</div>
                    }
                </td>
                <td>@(t.DueDate?.ToString("MMM d, yyyy") ?? "—")</td>
                <td>
                    @if (t.IsOverdue)
                    {
                        <span class="pill pill-overdue">Overdue</span>
                    }
                    else if (t.Status == WeddingTaskStatus.Completed)
                    {
                        <span class="pill pill-done">Completed</span>
                    }
                    else
                    {
                        <span class="pill pill-pending">@t.Status</span>
                    }
                </td>
                <td class="text-end">
                    <a class="link-gold" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                    @if (t.Status != WeddingTaskStatus.Completed)
                    {
                        <form asp-action="Complete" method="post" class="inline-form" style="margin-left:0.5rem;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn-ghost" style="padding:0;">Done</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
