@using WeddingManagementSystem.Models
@model List<DeliveryItem>
@{
    ViewData["Title"] = "Delivery";
}

<div class="toolbar">
    <h1 class="page-title">Delivery</h1>
    <a class="btn-gold" asp-action="Create">Add delivery</a>
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th>Item</th>
                <th>Vendor</th>
                <th>Date</th>
                <th>Location</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td><strong>@d.ItemName</strong></td>
                <td>@(d.VendorName ?? "—")</td>
                <td>@(d.DeliveryDate?.ToString("MMM d, yyyy") ?? "—")</td>
                <td>@(d.DropOffLocation ?? "—")</td>
                <td>
                    @if (d.Status == DeliveryStatus.Delivered)
                    {
                        <span class="pill pill-done">Delivered</span>
                    }
                    else
                    {
                        <span class="pill pill-pending">@d.Status</span>
                    }
                </td>
                <td class="text-end">
                    @if (d.Status != DeliveryStatus.Delivered)
                    {
                        <form asp-action="MarkDelivered" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@d.Id" />
                            <button type="submit" class="link-gold" style="background:none;border:0;cursor:pointer;">Mark delivered</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
