@using WeddingManagementSystem.Models
@model DeliveryItem
@{
    ViewData["Title"] = "Add delivery";
}

<h1 class="page-title">Add delivery</h1>
<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="ItemName">Item</label>
            <input asp-for="ItemName" required />
        </div>
        <div class="form-group">
            <label asp-for="VendorName">Vendor</label>
            <input asp-for="VendorName" />
        </div>
        <div class="form-group">
            <label asp-for="DeliveryDate">Delivery date</label>
            <input asp-for="DeliveryDate" type="date" />
        </div>
        <div class="form-group">
            <label asp-for="DropOffLocation">Drop-off location</label>
            <input asp-for="DropOffLocation" />
        </div>
        <div class="form-group">
            <label asp-for="Status"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<DeliveryStatus>()"></select>
        </div>
        <div class="form-group">
            <label asp-for="Notes"></label>
            <textarea asp-for="Notes" rows="2"></textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-gold">Save</button>
            <a class="btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
