@model WeddingManagementSystem.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register · Wedding Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-mark">W</div>
                <h1>Create account</h1>
                <p>Register to start managing wedding websites and gifts.</p>
            </div>

            <form asp-action="Register" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="auth-error"></div>

                <div class="form-group">
                    <label asp-for="DisplayName"></label>
                    <input asp-for="DisplayName" autocomplete="name" placeholder="Your name" autofocus />
                    <span asp-validation-for="DisplayName" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="username" placeholder="you@email.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
                <button type="submit" class="auth-submit">Create account</button>
            </form>

            <p class="auth-switch">
                Already have an account? <a asp-action="Login">Sign in</a>
            </p>
        </div>
    </div>
</body>
</html>
