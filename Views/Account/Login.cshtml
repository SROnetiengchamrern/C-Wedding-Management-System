@model WeddingManagementSystem.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in · Wedding Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-mark">W</div>
                <h1>Wedding Admin</h1>
                <p>Sign in to manage weddings, gifts, and invitations.</p>
            </div>

            <form asp-action="Login" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="auth-error"></div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="username" placeholder="you@email.com" autofocus />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <label class="auth-remember">
                    <input asp-for="RememberMe" /> Remember me
                </label>
                <button type="submit" class="auth-submit">Sign in</button>
            </form>

            <p class="auth-switch">
                New here? <a asp-action="Register">Create an account</a>
            </p>
            <p class="auth-hint muted sm-text">Demo: admin@wedding.local / Admin123!</p>
        </div>
    </div>
</body>
</html>
