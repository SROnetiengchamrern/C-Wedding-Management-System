@model WeddingManagementSystem.Models.WebsiteSettings
@{
    ViewData["Title"] = "Website Preview";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.SiteTitle</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
    <style>
        body { margin:0; font-family:"Source Sans 3",sans-serif; background:linear-gradient(160deg,#f7f3ee,#efe4d4); color:#2c241c; min-height:100vh; display:grid; place-items:center; text-align:center; padding:2rem; }
        h1 { font-family:"Cormorant Garamond",serif; font-size:clamp(2.5rem,8vw,4.5rem); margin:0 0 .5rem; }
        .meta { color:#7a6f64; margin-bottom:1.5rem; }
        .card { background:#fffdf9; border:1px solid #e6ddd2; border-radius:18px; padding:2.5rem; max-width:560px; box-shadow:0 12px 40px rgba(44,36,28,.06); }
        .btn { display:inline-block; margin-top:1.25rem; background:linear-gradient(180deg,#c9a36a,#8f7040); color:#fff; text-decoration:none; padding:.7rem 1.4rem; border-radius:999px; font-weight:600; }
        .badge { display:inline-block; font-size:.75rem; letter-spacing:.08em; text-transform:uppercase; color:#8f7040; background:#f3eadc; padding:.2rem .55rem; border-radius:999px; margin-bottom:1rem; }
    </style>
</head>
<body>
    <div class="card">
        <div class="badge">@(Model.IsPublished ? "Live preview" : "Draft preview")</div>
        <h1>@Model.SiteTitle</h1>
        @if (Model.Wedding is not null)
        {
            <p class="meta">@Model.Wedding.WeddingDate.ToString("MMMM d, yyyy") · @Model.Wedding.VenueName</p>
        }
        <p>@Model.WelcomeMessage</p>
        @if (!string.IsNullOrWhiteSpace(Model.RsvpUrl))
        {
            <a class="btn" href="@Model.RsvpUrl">RSVP</a>
        }
    </div>
</body>
</html>
