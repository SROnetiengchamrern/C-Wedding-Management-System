@using WeddingManagementSystem.Models
@model WebsiteSettings
@{
    Layout = null;
    var theme = InviteThemes.Get(Model.ThemeLayout);
    var title = Model.SiteTitle;
    var description = !string.IsNullOrWhiteSpace(Model.ShareDescription)
        ? Model.ShareDescription
        : Model.WelcomeMessage ?? "You're invited to our wedding.";
    var image = !string.IsNullOrWhiteSpace(Model.ShareImageUrl) ? Model.ShareImageUrl : Model.CoverImageUrl;
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/w/{Model.Slug}";
    var wedding = Model.Wedding;
    var mapQueryRaw = Model.MapSearch;
    if (string.IsNullOrWhiteSpace(mapQueryRaw) && wedding is not null)
    {
        mapQueryRaw = string.IsNullOrWhiteSpace(wedding.VenueLocation)
            ? wedding.VenueName
            : $"{wedding.VenueName}, {wedding.VenueLocation}";
    }
    var mapQuery = Uri.EscapeDataString(mapQueryRaw ?? "");
    var isSpotify = !string.IsNullOrWhiteSpace(Model.MusicUrl) &&
        Model.MusicUrl.Contains("spotify.com", StringComparison.OrdinalIgnoreCase);
    string? spotifyEmbed = null;
    if (isSpotify && Model.MusicUrl is not null)
    {
        var embedPath = Model.MusicUrl
            .Replace("open.spotify.com/", "open.spotify.com/embed/", StringComparison.OrdinalIgnoreCase)
            .Split('?', '#')[0]
            .TrimEnd('/');
        spotifyEmbed = embedPath + "?utm_source=generator&theme=0&autoplay=1";
    }
    var hasMusic = !string.IsNullOrWhiteSpace(Model.MusicUrl);
    var hasDress = !string.IsNullOrWhiteSpace(Model.DressCode) || !string.IsNullOrWhiteSpace(Model.DressCodeKh);
    var hasSchedule = !string.IsNullOrWhiteSpace(Model.ScheduleText) || !string.IsNullOrWhiteSpace(Model.ScheduleTextKh);
    var hasKhText =
        !string.IsNullOrWhiteSpace(Model.WelcomeMessageKh) ||
        !string.IsNullOrWhiteSpace(Model.InviteMessageKh) ||
        !string.IsNullOrWhiteSpace(Model.DressCodeKh) ||
        !string.IsNullOrWhiteSpace(Model.ScheduleTextKh);
    string Pick(string? en, string? kh) =>
        !string.IsNullOrWhiteSpace(en) ? en! : (kh ?? "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@pageUrl" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:site_name" content="Wedding Invitation" />
    @if (!string.IsNullOrWhiteSpace(image))
    {
        <meta property="og:image" content="@image" />
    }
    <meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(image) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    @if (!string.IsNullOrWhiteSpace(image))
    {
        <meta name="twitter:image" content="@image" />
    }
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Hanuman:wght@400;700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --inv-primary: @theme.Primary;
            --inv-accent: @theme.Accent;
            --inv-bg: @theme.Bg;
            --inv-card: @theme.Card;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Source Sans 3", sans-serif;
            background: var(--inv-bg);
            color: @(theme.Id == 3 ? "#f3eadc" : "#2c241c");
            min-height: 100vh;
            position: relative;
        }
        body.inv-loading {
            overflow: hidden;
        }
        #heartBg {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
            opacity: 0.35;
            transition: opacity 0.8s ease;
        }
        body.inv-loading #heartBg {
            z-index: 100;
            opacity: 1;
        }
        #heartBg canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
        }
        #heartPathSvg {
            position: absolute;
            width: 0;
            height: 0;
            overflow: hidden;
            pointer-events: none;
        }
        .inv-loader {
            position: fixed;
            inset: 0;
            z-index: 99;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            background: radial-gradient(ellipse at center, var(--loader-mid, #2a1520) 0%, var(--loader-deep, #12080c) 70%);
            color: #fff;
            transition: opacity 0.7s ease, visibility 0.7s ease;
        }
        body[data-effect="3"] .inv-loader {
            --loader-mid: #1a2430;
            --loader-deep: #0a1018;
        }
        body[data-effect="5"] .inv-loader {
            --loader-mid: #2a2010;
            --loader-deep: #120c06;
        }
        body[data-effect="4"] .inv-loader {
            --loader-mid: #2a1018;
            --loader-deep: #14060c;
        }
        .inv-loader.is-done {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        .inv-loader-title {
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(1.6rem, 5vw, 2.4rem);
            font-weight: 600;
            letter-spacing: 0.02em;
            text-align: center;
            padding: 0 1rem;
            position: relative;
            z-index: 102;
            text-shadow: 0 4px 24px rgba(238, 82, 130, 0.45);
        }
        .inv-loader-sub {
            font-size: 0.85rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            opacity: 0.7;
            position: relative;
            z-index: 101;
        }
        .inv-wrap {
            position: relative;
            z-index: 1;
            max-width: 720px;
            margin: 0 auto;
            padding: 1.5rem 1rem 3rem;
            opacity: 0;
            transform: translateY(12px);
            transition: opacity 0.7s ease 0.15s, transform 0.7s ease 0.15s;
        }
        body.inv-ready .inv-wrap {
            opacity: 1;
            transform: none;
        }
        .inv-hero {
            border-radius: 18px;
            overflow: hidden;
            background: var(--inv-card);
            border: 1px solid color-mix(in srgb, var(--inv-primary) 18%, transparent);
            box-shadow: 0 16px 40px rgba(0,0,0,.06);
            text-align: center;
        }
        .inv-cover { width: 100%; max-height: 360px; object-fit: cover; display: block; }
        .inv-body { padding: 1.75rem 1.4rem 2rem; }
        .inv-badge {
            display: inline-block;
            font-size: .72rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--inv-primary);
            background: color-mix(in srgb, var(--inv-accent) 18%, transparent);
            padding: .25rem .6rem;
            border-radius: 999px;
            margin-bottom: .85rem;
        }
        h1 {
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(2.2rem, 7vw, 3.6rem);
            margin: 0 0 .4rem;
            color: var(--inv-primary);
            line-height: 1.1;
        }
        .inv-meta { opacity: .75; margin: 0 0 1rem; }
        .inv-msg { line-height: 1.55; margin: 0 0 1.25rem; }
        .inv-btn {
            display: inline-block;
            background: linear-gradient(180deg, var(--inv-accent), var(--inv-primary));
            color: #fff;
            text-decoration: none;
            padding: .7rem 1.35rem;
            border-radius: 999px;
            font-weight: 600;
        }
        .inv-section { margin-top: 1.35rem; }
        .inv-section h2 {
            font-family: "Cormorant Garamond", serif;
            color: var(--inv-primary);
            font-size: 1.55rem;
            margin: 0 0 .75rem;
        }
        .inv-lang {
            position: fixed;
            top: 0.75rem;
            right: 0.75rem;
            z-index: 50;
            display: flex;
            gap: 0.25rem;
            padding: 0.2rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--inv-card) 92%, transparent);
            border: 1px solid color-mix(in srgb, var(--inv-primary) 18%, transparent);
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
            backdrop-filter: blur(8px);
        }
        body.inv-loading .inv-lang { opacity: 0; pointer-events: none; }
        body.inv-ready .inv-lang { opacity: 1; transition: opacity .4s ease; }
        .inv-lang button {
            border: 0;
            background: transparent;
            color: var(--inv-primary);
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            padding: 0.4rem 0.7rem;
            border-radius: 999px;
            cursor: pointer;
        }
        .inv-lang button.is-active {
            background: linear-gradient(180deg, var(--inv-accent), var(--inv-primary));
            color: #fff;
        }
        body.lang-kh .inv-kh-font,
        body.lang-kh .i18n {
            font-family: "Hanuman", "Source Sans 3", sans-serif;
            line-height: 1.65;
        }
        .schedule-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 0.55rem;
        }
        .schedule-list li {
            padding: 0.75rem 0.9rem;
            border-radius: 12px;
            background: color-mix(in srgb, var(--inv-accent) 12%, var(--inv-card));
            border: 1px solid color-mix(in srgb, var(--inv-primary) 12%, transparent);
            font-size: 0.95rem;
            display: grid;
            gap: 0.2rem;
        }
        .schedule-list .schedule-time {
            font-weight: 700;
            color: var(--inv-primary);
            font-size: 0.88rem;
            letter-spacing: 0.02em;
        }
        .schedule-list .schedule-event {
            line-height: 1.4;
        }
        .inv-info-pair {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
            margin-top: 1.35rem;
        }
        .inv-info-pair > .inv-section {
            margin-top: 0;
            padding: 1rem 1.05rem;
            border-radius: 16px;
            background: color-mix(in srgb, var(--inv-card) 88%, transparent);
            border: 1px solid color-mix(in srgb, var(--inv-primary) 12%, transparent);
        }
        @@media (min-width: 560px) {
            .inv-info-pair {
                grid-template-columns: 1fr 1fr;
                align-items: start;
            }
        }
        body.lang-kh .lang-panel.lang-en { display: none !important; }
        body:not(.lang-kh) .lang-panel.lang-kh { display: none !important; }
        .lang-panel[hidden] { display: none !important; }
        .dress-code-text {
            margin: 0;
            font-size: 1.05rem;
            line-height: 1.55;
        }
        .inv-dock-info {
            background: color-mix(in srgb, var(--inv-accent) 22%, var(--inv-card));
            color: var(--inv-primary);
        }

        /* Scroll reveal (up & down) */
        .inv-hero,
        .inv-section {
            opacity: 0;
            transform: translateY(28px);
            transition-property: opacity, transform;
            transition-duration: 400ms, 440ms;
            transition-delay: 0ms, 0ms;
            transition-timing-function: cubic-bezier(0.4, 0, 1, 1), cubic-bezier(0.4, 0, 0.72, 1);
            will-change: opacity, transform;
        }
        .inv-hero.is-visible,
        .inv-section.is-visible {
            opacity: 1;
            transform: translateY(0);
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1), cubic-bezier(0.22, 1, 0.36, 1);
        }
        @@media (prefers-reduced-motion: reduce) {
            .inv-hero,
            .inv-section,
            .octagon-item {
                opacity: 1;
                transform: none;
                transition: none;
            }
        }

        /* Footer octagon gallery */
        .inv-footer-gallery {
            margin-top: 2.25rem;
            padding: 1.75rem 1rem 2rem;
            border-radius: 18px;
            background: color-mix(in srgb, var(--inv-accent) 10%, var(--inv-bg));
            border: 1px solid color-mix(in srgb, var(--inv-primary) 12%, transparent);
            text-align: center;
        }
        .inv-footer-gallery h2 {
            font-family: "Cormorant Garamond", serif;
            color: var(--inv-primary);
            font-size: 1.55rem;
            margin: 0 0 1.15rem;
        }
        .octagon-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem 1.1rem;
            justify-items: center;
            max-width: 560px;
            margin: 0 auto;
        }
        .octagon-item {
            width: 100%;
            max-width: 110px;
            aspect-ratio: 1;
            opacity: 0;
            transform: translateY(20px) scale(.94);
            transition-property: opacity, transform;
            transition-duration: 400ms, 440ms;
            transition-delay: 0ms, 0ms;
            transition-timing-function: cubic-bezier(0.4, 0, 1, 1), cubic-bezier(0.4, 0, 0.72, 1);
            will-change: opacity, transform;
        }
        .octagon-item.is-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1), cubic-bezier(0.22, 1, 0.36, 1);
        }
        .octagon-item:nth-child(1) { transition-delay: 0ms, 0ms; }
        .octagon-item:nth-child(2) { transition-delay: 40ms, 40ms; }
        .octagon-item:nth-child(3) { transition-delay: 80ms, 80ms; }
        .octagon-item:nth-child(4) { transition-delay: 120ms, 120ms; }
        .octagon-item:nth-child(5) { transition-delay: 60ms, 60ms; }
        .octagon-item:nth-child(6) { transition-delay: 100ms, 100ms; }
        .octagon-item:nth-child(7) { transition-delay: 140ms, 140ms; }
        .octagon-item:nth-child(8) { transition-delay: 180ms, 180ms; }
        .octagon-frame {
            width: 100%;
            height: 100%;
            clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);
            overflow: hidden;
            background: var(--inv-card);
            filter: drop-shadow(0 8px 16px rgba(44, 36, 28, .16));
        }
        .octagon-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        .octagon-item:hover .octagon-frame img {
            transform: scale(1.06);
        }
        @@media (max-width: 560px) {
            .octagon-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: .85rem;
            }
            .octagon-item { max-width: 140px; }
        }

        .gallery-3d {
            background: var(--inv-card);
            border-radius: 20px;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 15%, transparent);
            padding: 1.5rem 1rem 1.25rem;
            text-align: center;
            overflow: hidden;
        }
        .gallery-3d-stage {
            position: relative;
            height: clamp(260px, 56vw, 360px);
            margin: 0.35rem 0 0.25rem;
            perspective: 1100px;
            perspective-origin: 50% 50%;
            touch-action: pan-y;
            user-select: none;
        }
        .gallery-3d-card {
            position: absolute;
            top: 50%;
            left: 50%;
            width: min(52%, 240px);
            aspect-ratio: 3 / 4;
            margin: 0;
            border-radius: 18px;
            overflow: hidden;
            background: #1a1216;
            box-shadow: 0 14px 32px rgba(44, 20, 30, 0.18);
            transform: translate(-50%, -50%);
            transform-style: preserve-3d;
            transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                        filter 0.45s ease,
                        opacity 0.45s ease,
                        box-shadow 0.45s ease;
            will-change: transform, filter, opacity;
            cursor: pointer;
        }
        .gallery-3d-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            pointer-events: none;
        }
        .gallery-3d-card.is-active {
            box-shadow: 0 18px 40px rgba(44, 20, 30, 0.26);
            cursor: default;
        }
        .gallery-3d-card.is-far {
            pointer-events: none;
        }
        .gallery-3d-caption {
            margin: 1rem 0 0.65rem;
            min-height: 1.35em;
            font-size: 0.92rem;
            color: color-mix(in srgb, var(--inv-primary) 55%, #666);
            opacity: 0.9;
            transition: opacity 0.25s ease;
        }
        .gallery-3d .inv-carousel-controls {
            margin-top: 0.15rem;
            margin-bottom: 0.15rem;
        }
        @@media (max-width: 560px) {
            .gallery-3d {
                padding: 1.25rem 0.75rem 1.1rem;
            }
            .gallery-3d-card { width: min(58%, 200px); }
            .gallery-3d-stage {
                height: clamp(240px, 70vw, 310px);
                margin: 0.25rem 0;
            }
            .gallery-3d-caption {
                margin: 0.85rem 0 0.55rem;
            }
        }
        @@media (prefers-reduced-motion: reduce) {
            .gallery-3d-card {
                transition: opacity 0.25s ease;
            }
        }
        .qr-carousel {
            background: var(--inv-card);
            border-radius: 16px;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 15%, transparent);
            padding: 1rem 1rem 1.15rem;
            text-align: center;
        }
        .qr-slides { position: relative; min-height: 220px; }
        .qr-slide {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: .55rem;
            animation: invFade .25s ease;
        }
        .qr-slide.active { display: flex; }
        .qr-slide img {
            width: min(100%, 280px);
            height: auto;
            border-radius: 12px;
            background: #fff;
        }
        .qr-slide figcaption {
            font-size: .9rem;
            opacity: .8;
            margin: 0;
        }
        @@keyframes invFade {
            from { opacity: .35; transform: translateY(4px); }
            to { opacity: 1; transform: none; }
        }
        .inv-carousel-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .55rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }
        .inv-carousel-controls button,
        .qr-download {
            appearance: none;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 35%, transparent);
            background: #fff;
            color: var(--inv-primary);
            font: inherit;
            font-weight: 600;
            padding: .5rem 1rem;
            border-radius: 999px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }
        .inv-carousel-controls button:disabled {
            opacity: .4;
            cursor: not-allowed;
        }
        .qr-download {
            background: linear-gradient(180deg, var(--inv-accent), var(--inv-primary));
            color: #fff;
            border-color: transparent;
        }
        .inv-carousel-counter {
            font-size: .88rem;
            opacity: .75;
            min-width: 3.5rem;
        }
        .music-box { margin-top: .5rem; }
        .music-box iframe {
            width: 100%;
            height: 152px;
            border-radius: 12px;
            border: 0;
        }
        .music-float {
            position: fixed;
            right: 1rem;
            bottom: 4.6rem;
            z-index: 60;
            width: 3rem;
            height: 3rem;
            border-radius: 999px;
            border: 0;
            cursor: pointer;
            display: none;
            align-items: center;
            justify-content: center;
            background: linear-gradient(180deg, var(--inv-accent), var(--inv-primary));
            color: #fff;
            box-shadow: 0 10px 24px rgba(0,0,0,.18);
            font-size: 1.15rem;
            line-height: 1;
        }
        body.inv-ready .music-float { display: inline-flex; }
        .music-float.is-playing { animation: musicPulse 1.4s ease-in-out infinite; }
        .music-float-tip {
            position: fixed;
            right: 4.3rem;
            bottom: 5.05rem;
            z-index: 60;
            background: rgba(44, 36, 28, .88);
            color: #fff;
            font-size: .78rem;
            padding: .4rem .7rem;
            border-radius: 999px;
            display: none;
            white-space: nowrap;
        }
        body.inv-ready .music-float-tip.is-on { display: block; }
        @@keyframes musicPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.06); }
        }
        .inv-thanks {
            margin-top: 2rem;
            padding: 1.75rem 1.25rem 2rem;
            text-align: center;
            border-radius: 18px;
            background: color-mix(in srgb, var(--inv-accent) 12%, var(--inv-card));
            border: 1px solid color-mix(in srgb, var(--inv-primary) 14%, transparent);
        }
        .inv-thanks-title {
            font-family: "Cormorant Garamond", serif;
            font-size: 1.8rem;
            color: var(--inv-primary);
            margin: 0 0 .35rem;
        }
        .inv-thanks-text {
            margin: 0;
            line-height: 1.5;
            opacity: .85;
        }
        .scroll-top {
            position: fixed;
            left: 1rem;
            bottom: 4.6rem;
            z-index: 60;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 999px;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 25%, transparent);
            background: rgba(255,255,255,.94);
            color: var(--inv-primary);
            cursor: pointer;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 8px 20px rgba(0,0,0,.12);
        }
        body.inv-ready .scroll-top.is-on { display: inline-flex; }
        .map-frame {
            border: 0;
            width: 100%;
            height: 260px;
            border-radius: 14px;
            background: #ddd;
        }
        .rsvp-card {
            background: var(--inv-card);
            border: 1px solid color-mix(in srgb, var(--inv-primary) 15%, transparent);
            border-radius: 16px;
            padding: 1.25rem 1.15rem 1.35rem;
            box-shadow: 0 10px 28px rgba(0,0,0,.04);
        }
        .rsvp-card h2 { margin-top: 0; }
        .rsvp-card label.field-label {
            display: block;
            font-weight: 600;
            margin: .85rem 0 .35rem;
        }
        .rsvp-card input[type="text"],
        .rsvp-card input[type="email"],
        .rsvp-card textarea {
            width: 100%;
            border: 1px solid #e5e0da;
            border-radius: 10px;
            padding: .65rem .75rem;
            background: #fff;
            color: inherit;
            font: inherit;
        }
        .rsvp-card input:focus,
        .rsvp-card textarea:focus {
            outline: none;
            border-color: var(--inv-primary);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--inv-primary) 18%, transparent);
        }
        .rsvp-options { display: flex; flex-direction: column; gap: .45rem; }
        .rsvp-option {
            display: flex;
            align-items: center;
            gap: .55rem;
            border: 1px solid #e5e0da;
            border-radius: 12px;
            padding: .7rem .85rem;
            background: #fff;
            cursor: pointer;
        }
        .rsvp-option:has(input:checked) {
            background: color-mix(in srgb, var(--inv-accent) 16%, #fff);
            border-color: var(--inv-primary);
        }
        .rsvp-submit {
            width: 100%;
            margin-top: 1rem;
            border: 0;
            cursor: pointer;
            text-align: center;
        }
        .rsvp-banner {
            border-radius: 12px;
            padding: .7rem .85rem;
            margin-bottom: .85rem;
            background: color-mix(in srgb, var(--inv-accent) 18%, #fff);
            color: var(--inv-primary);
            font-weight: 600;
        }
        .rsvp-banner.error { background: #fde8e8; color: #8a1f1f; }

        /* Fixed quick-nav dock */
        html { scroll-behavior: smooth; }
        body { padding-bottom: 5.5rem; }
        .inv-dock {
            position: fixed;
            left: 50%;
            bottom: 1.1rem;
            transform: translateX(-50%);
            z-index: 50;
            display: flex;
            align-items: center;
            gap: .45rem;
            padding: .4rem .5rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, .94);
            border: 1px solid rgba(255, 255, 255, .8);
            box-shadow:
                0 0 0 1px rgba(80, 60, 90, .06),
                0 10px 28px rgba(60, 40, 70, .16),
                0 0 24px rgba(180, 160, 210, .35);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            max-width: calc(100vw - 1.25rem);
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s ease 0.25s;
        }
        body.inv-ready .inv-dock {
            opacity: 1;
            pointer-events: auto;
        }
        .inv-dock::-webkit-scrollbar { display: none; }
        .inv-dock a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2.35rem;
            padding: .45rem 1.05rem;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-decoration: none;
            text-transform: uppercase;
            white-space: nowrap;
            transition: transform 180ms ease, filter 180ms ease;
        }
        .inv-dock a:hover { transform: translateY(-1px); filter: brightness(.97); }
        .inv-dock a:active { transform: translateY(0); }
        .inv-dock a.is-active { box-shadow: inset 0 0 0 1.5px currentColor; }
        .inv-dock-gallery {
            background: #d9d6ef;
            color: #3b2f5c;
        }
        .inv-dock-rsvp {
            background: #f3c9c5;
            color: #6b2c2c;
        }
        .inv-dock-bank {
            background: #f3e2b0;
            color: #5c4520;
        }
        .inv-dock-home {
            background: #d8ebe3;
            color: #1f4d3d;
        }
        .inv-dock-map {
            background: #d4e4f5;
            color: #1e3f66;
        }
        .inv-dock-music {
            background: #ecd9f2;
            color: #5a2d6b;
        }
        .inv-dock-countdown {
            background: #fde2ea;
            color: #9f1239;
        }
        .inv-dock-share {
            background: #e4f0ff;
            color: #1e4a7a;
        }
        .inv-dock-moments {
            background: #f5ddd0;
            color: #6b3a28;
        }

        /* Countdown + share */
        .countdown-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .65rem;
        }
        .countdown-box {
            background: var(--inv-card);
            border: 1px solid color-mix(in srgb, var(--inv-primary) 15%, transparent);
            border-radius: 14px;
            padding: .9rem .5rem;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0,0,0,.04);
        }
        .countdown-box strong {
            display: block;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(1.6rem, 5vw, 2.2rem);
            color: var(--inv-primary);
            line-height: 1;
        }
        .countdown-box span {
            display: block;
            margin-top: .35rem;
            font-size: .72rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            opacity: .7;
        }
        .countdown-done {
            text-align: center;
            font-family: "Cormorant Garamond", serif;
            font-size: 1.4rem;
            color: var(--inv-primary);
            margin: 0;
        }
        .share-row {
            display: flex;
            flex-wrap: wrap;
            gap: .55rem;
        }
        .share-btn {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            border-radius: 999px;
            padding: .55rem 1rem;
            font-size: .88rem;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 20%, transparent);
            background: var(--inv-card);
            color: inherit;
            cursor: pointer;
            font-family: inherit;
        }
        .share-btn:hover { filter: brightness(.97); }
        .share-btn.primary {
            background: linear-gradient(180deg, var(--inv-accent), var(--inv-primary));
            color: #fff;
            border-color: transparent;
        }
        .share-hint {
            margin: .65rem 0 0;
            font-size: .85rem;
            opacity: .7;
            min-height: 1.2em;
        }
        @@media (max-width: 480px) {
            .countdown-grid { gap: .45rem; }
            .countdown-box { padding: .7rem .3rem; }
        }

        @@media (max-width: 420px) {
            .inv-dock { gap: .3rem; padding: .35rem .4rem; }
            .inv-dock a { padding: .42rem .72rem; font-size: .68rem; letter-spacing: .04em; }
        }

        /* Falling overlay effects */
        #heartSnow {
            position: fixed;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            overflow: hidden;
            opacity: 0;
            transition: opacity 0.8s ease;
        }
        body.inv-loading #heartSnow.has-effect,
        body.inv-ready #heartSnow.has-effect { opacity: 1; }
        body.inv-loading #heartSnow {
            z-index: 101;
            opacity: 0.55;
        }
        .fall-item {
            position: absolute;
            top: -12vh;
            left: 0;
            will-change: transform, opacity;
            animation-name: invFall;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
            user-select: none;
        }
        .fall-heart {
            color: #ee5282;
            font-size: 1rem;
            text-shadow: 0 2px 8px rgba(238, 82, 130, 0.35);
            line-height: 1;
        }
        .fall-heart.is-soft { color: #f7a0bc; opacity: 0.85; }
        .fall-heart.is-deep { color: #d63a6a; }
        .fall-snow {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
        }
        .fall-snow.is-pink {
            background: rgba(255, 190, 210, 0.85);
            box-shadow: 0 0 8px rgba(238, 82, 130, 0.35);
        }
        .fall-petal {
            width: 12px;
            height: 16px;
            border-radius: 80% 0 55% 50% / 55% 0 80% 50%;
            background: linear-gradient(145deg, #f9a8c4, #e11d48);
            opacity: 0.85;
            box-shadow: 0 2px 8px rgba(225, 29, 72, 0.25);
        }
        .fall-petal.is-soft {
            background: linear-gradient(145deg, #fecdd3, #fb7185);
        }
        .fall-sparkle {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #f5d78e;
            box-shadow: 0 0 10px rgba(245, 215, 142, 0.95), 0 0 2px #fff;
        }
        .fall-sparkle.is-star {
            width: auto;
            height: auto;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            color: #eab308;
            font-size: 0.85rem;
            text-shadow: 0 0 8px rgba(234, 179, 8, 0.55);
            line-height: 1;
        }
        @@keyframes invFall {
            0% {
                transform: translate3d(0, -10vh, 0) rotate(0deg);
                opacity: 0;
            }
            8% { opacity: 1; }
            92% { opacity: 0.9; }
            100% {
                transform: translate3d(var(--drift), 110vh, 0) rotate(var(--spin));
                opacity: 0;
            }
        }
        @@media (prefers-reduced-motion: reduce) {
            #heartSnow { display: none; }
        }
    </style>
</head>
<body class="inv-loading" data-effect="@Model.EffectStyle" data-lang="en">
    @if (hasKhText)
    {
        <div class="inv-lang" id="invLang" role="group" aria-label="Language">
            <button type="button" data-lang="en" class="is-active">EN</button>
            <button type="button" data-lang="kh">ខ្មែរ</button>
        </div>
    }
    <div class="inv-loader" id="invLoader" aria-live="polite">
        <div class="inv-loader-title">@title</div>
        <!-- <div class="inv-loader-sub">Loading invitation</div> -->
    </div>
    <div id="heartBg" aria-hidden="true"></div>
    <div id="heartSnow" aria-hidden="true" data-effect="@Model.EffectStyle"></div>
    <svg id="heartPathSvg" viewBox="0 0 600 552" aria-hidden="true">
        <path id="heartPath" d="M300,107.77C284.68,55.67,239.76,0,162.31,0,64.83,0,0,82.08,0,171.71c0,.48,0,.95,0,1.43-.52,19.5,0,217.94,299.87,379.69v0l0,0,.05,0,0,0,0,0v0C600,391.08,600.48,192.64,600,173.14c0-.48,0-.95,0-1.43C600,82.08,535.17,0,437.69,0,360.24,0,315.32,55.67,300,107.77" fill="#ee5282"></path>
    </svg>

    <div class="inv-wrap">
        <article class="inv-hero" id="home">
            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl ?? image))
            {
                <img class="inv-cover" src="@(Model.CoverImageUrl ?? image)" alt="@title" />
            }
            <div class="inv-body">
                <div class="inv-badge i18n"
                     data-en="@(Model.IsPublished ? "You're invited" : "Draft preview")"
                     data-kh="@(Model.IsPublished ? "អ្នកត្រូវបានអញ្ជើញ" : "មើលសេចក្តីព្រាង")">
                    @(Model.IsPublished ? "You're invited" : "Draft preview")
                </div>
                <h1>@title</h1>
                @if (wedding is not null)
                {
                    <p class="inv-meta">
                        @wedding.WeddingDate.ToString("MMMM d, yyyy")
                        @if (!string.IsNullOrWhiteSpace(wedding.VenueName))
                        {
                            <text> · @wedding.VenueName</text>
                            @if (!string.IsNullOrWhiteSpace(wedding.VenueLocation))
                            {
                                <text>, @wedding.VenueLocation</text>
                            }
                        }
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.WelcomeMessage) || !string.IsNullOrWhiteSpace(Model.WelcomeMessageKh))
                {
                    <p class="inv-msg i18n"
                       data-en="@Pick(Model.WelcomeMessage, Model.WelcomeMessageKh)"
                       data-kh="@Pick(Model.WelcomeMessageKh, Model.WelcomeMessage)">@Pick(Model.WelcomeMessage, Model.WelcomeMessageKh)</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.InviteMessage) || !string.IsNullOrWhiteSpace(Model.InviteMessageKh))
                {
                    <p class="inv-msg i18n"
                       data-en="@Pick(Model.InviteMessage, Model.InviteMessageKh)"
                       data-kh="@Pick(Model.InviteMessageKh, Model.InviteMessage)">@Pick(Model.InviteMessage, Model.InviteMessageKh)</p>
                }
            </div>
        </article>

        @if (wedding is not null)
        {
            <section class="inv-section" id="countdown">
                <h2 class="i18n" data-en="Counting down" data-kh="រាប់ថយក្រោយ">Counting down</h2>
                <div class="countdown-grid" id="countdownGrid"
                     data-wedding-date="@wedding.WeddingDate.ToString("yyyy-MM-dd")"
                     hidden>
                    <div class="countdown-box"><strong data-cd="days">0</strong><span class="i18n" data-en="Days" data-kh="ថ្ងៃ">Days</span></div>
                    <div class="countdown-box"><strong data-cd="hours">0</strong><span class="i18n" data-en="Hours" data-kh="ម៉ោង">Hours</span></div>
                    <div class="countdown-box"><strong data-cd="mins">0</strong><span class="i18n" data-en="Mins" data-kh="នាទី">Mins</span></div>
                    <div class="countdown-box"><strong data-cd="secs">0</strong><span class="i18n" data-en="Secs" data-kh="វិនាទី">Secs</span></div>
                </div>
                <p class="countdown-done i18n" id="countdownDone" hidden
                   data-en="Today is the day — celebrate with us!"
                   data-kh="ថ្ងៃនេះជាថ្ងៃពិសេស — សូមអបអរជាមួយយើង!">Today is the day — celebrate with us!</p>
                <div class="share-row" style="margin-top:1rem;">
                    <button type="button" class="share-btn primary i18n" id="addToCalendarBtn"
                            data-title="@title"
                            data-date="@wedding.WeddingDate.ToString("yyyy-MM-dd")"
                            data-venue="@($"{wedding.VenueName}{(string.IsNullOrWhiteSpace(wedding.VenueLocation) ? "" : ", " + wedding.VenueLocation)}")"
                            data-desc="@description"
                            data-en="Add to calendar"
                            data-kh="បញ្ចូលក្នុងប្រតិទិន">
                        Add to calendar
                    </button>
                    <a class="share-btn i18n" href="#rsvp" data-en="RSVP now" data-kh="ផ្ញើ RSVP">RSVP now</a>
                </div>
            </section>
        }

        @if (hasDress || hasSchedule)
        {
            var scheduleEn = (Model.ScheduleText ?? Model.ScheduleTextKh ?? "")
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var scheduleKh = (Model.ScheduleTextKh ?? Model.ScheduleText ?? "")
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            <div class="inv-info-pair">
                @if (hasDress)
                {
                    <section class="inv-section" id="dress-code">
                        <h2 class="i18n" data-en="Dress code" data-kh="សម្លៀកបំពាក់">Dress code</h2>
                        <p class="dress-code-text i18n inv-kh-font"
                           data-en="@Pick(Model.DressCode, Model.DressCodeKh)"
                           data-kh="@Pick(Model.DressCodeKh, Model.DressCode)">@Pick(Model.DressCode, Model.DressCodeKh)</p>
                    </section>
                }
                @if (hasSchedule)
                {
                    <section class="inv-section" id="schedule">
                        <h2 class="i18n" data-en="Schedule" data-kh="កាលវិភាគ">Schedule</h2>
                        <ul class="schedule-list lang-panel lang-en">
                            @foreach (var line in scheduleEn)
                            {
                                var parts = System.Text.RegularExpressions.Regex.Split(line, @"\s*(?:--|—|–)\s*");
                                var time = parts.Length > 1 ? parts[0].Trim() : null;
                                var evt = parts.Length > 1 ? string.Join(" — ", parts.Skip(1)).Trim() : line;
                                <li>
                                    @if (!string.IsNullOrWhiteSpace(time))
                                    {
                                        <span class="schedule-time">@time</span>
                                        <span class="schedule-event">@evt</span>
                                    }
                                    else
                                    {
                                        <span class="schedule-event">@line</span>
                                    }
                                </li>
                            }
                        </ul>
                        <ul class="schedule-list lang-panel lang-kh" hidden>
                            @foreach (var line in scheduleKh)
                            {
                                var parts = System.Text.RegularExpressions.Regex.Split(line, @"\s*(?:--|—|–)\s*");
                                var time = parts.Length > 1 ? parts[0].Trim() : null;
                                var evt = parts.Length > 1 ? string.Join(" — ", parts.Skip(1)).Trim() : line;
                                <li class="inv-kh-font">
                                    @if (!string.IsNullOrWhiteSpace(time))
                                    {
                                        <span class="schedule-time">@time</span>
                                        <span class="schedule-event">@evt</span>
                                    }
                                    else
                                    {
                                        <span class="schedule-event">@line</span>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }

        @if (Model.GalleryPhotos.Any())
        {
            var galleryList = Model.GalleryPhotos.ToList();
            <section class="inv-section" id="gallery">
                <h2 class="i18n" data-en="Gallery" data-kh="រូបភាព">Gallery</h2>
                <div class="gallery-3d" id="gallery3d" data-autoplay="4000">
                    <div class="gallery-3d-stage" data-gallery-stage>
                        @for (var i = 0; i < galleryList.Count; i++)
                        {
                            var p = galleryList[i];
                            <figure class="gallery-3d-card @(i == 0 ? "is-active" : "")"
                                    data-index="@i"
                                    data-label="@(string.IsNullOrWhiteSpace(p.Label) ? $"Photo {i + 1}" : p.Label)">
                                <img src="@p.FilePath" alt="@(string.IsNullOrWhiteSpace(p.Label) ? $"Photo {i + 1}" : p.Label)" loading="@(i == 0 ? "eager" : "lazy")" />
                            </figure>
                        }
                    </div>
                    <p class="gallery-3d-caption" data-gallery-caption>@(string.IsNullOrWhiteSpace(galleryList[0].Label) ? "Photo 1" : galleryList[0].Label)</p>
                    <div class="inv-carousel-controls">
                        <button type="button" data-gallery-prev aria-label="Previous photo">‹ Prev</button>
                        <span class="inv-carousel-counter" data-gallery-counter>1 / @galleryList.Count</span>
                        <button type="button" data-gallery-next aria-label="Next photo">Next ›</button>
                    </div>
                </div>
            </section>
        }

        @if (Model.BankQrs.Any())
        {
            var qrList = Model.BankQrs.ToList();
            <section class="inv-section" id="bank-qr">
                <h2 class="i18n" data-en="Bank transfer QR" data-kh="QR ផ្ទេរប្រាក់">Bank transfer QR</h2>
                <div class="qr-carousel" data-carousel data-slide=".qr-slide" data-has-download="true">
                    <div class="qr-slides">
                        @for (var i = 0; i < qrList.Count; i++)
                        {
                            var q = qrList[i];
                            var fileName = System.IO.Path.GetFileName(q.FilePath) ?? $"bank-qr-{i + 1}.png";
                            <figure class="qr-slide @(i == 0 ? "active" : "")" data-src="@q.FilePath" data-name="@fileName">
                                <img src="@q.FilePath" alt="@q.Label" />
                                <figcaption>@q.Label</figcaption>
                            </figure>
                        }
                    </div>
                    <div class="inv-carousel-controls">
                        <button type="button" data-carousel-prev aria-label="Previous QR">‹ Prev</button>
                        <span class="inv-carousel-counter" data-carousel-counter>1 / @qrList.Count</span>
                        <button type="button" data-carousel-next aria-label="Next QR">Next ›</button>
                        <a class="qr-download" data-carousel-download href="@qrList[0].FilePath" download="@(System.IO.Path.GetFileName(qrList[0].FilePath) ?? "bank-qr.png")">Download</a>
                    </div>
                </div>
            </section>
        }

        @if (Model.ShowMap && !string.IsNullOrWhiteSpace(mapQuery))
        {
            <section class="inv-section" id="map">
                <h2 class="i18n" data-en="Venue map" data-kh="ផែនទីទីកន្លែង">Venue map</h2>
                <iframe class="map-frame" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                        src="https://maps.google.com/maps?q=@mapQuery&z=15&output=embed"
                        title="Venue map"></iframe>
                <p style="margin:.5rem 0 0;">
                    <a class="inv-btn i18n" style="padding:.45rem 1rem;font-size:.9rem;" href="https://www.google.com/maps/search/?api=1&query=@mapQuery" target="_blank" rel="noopener"
                       data-en="Open in Google Maps" data-kh="បើកក្នុង Google Maps">Open in Google Maps</a>
                </p>
            </section>
        }
        else if (!Model.ShowMap && wedding is not null && !string.IsNullOrWhiteSpace(wedding.VenueName))
        {
            <section class="inv-section" id="map">
                <h2 class="i18n" data-en="Venue" data-kh="ទីកន្លែង">Venue</h2>
                <p class="inv-meta">@wedding.VenueName@(string.IsNullOrWhiteSpace(wedding.VenueLocation) ? "" : $", {wedding.VenueLocation}")</p>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.MusicUrl))
        {
            <section class="inv-section" id="music">
                <h2 class="i18n" data-en="Music" data-kh="តន្ត្រី">Music</h2>
                <div class="music-box">
                    @if (spotifyEmbed is not null)
                    {
                        <iframe id="spotifyPlayer"
                                src="@spotifyEmbed"
                                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                                loading="eager"
                                title="Wedding music"></iframe>
                        <p class="inv-meta i18n" style="margin:.55rem 0 0;font-size:.85rem;"
                           data-en="Music autoplays when your browser allows it. Tap ♪ if it is quiet."
                           data-kh="តន្ត្រីចាក់ស្វ័យប្រវត្តិ ប្រសិនបើកម្មវិធីអនុញ្ញាត។ ចុច ♪ បើស្ងាត់។">Music autoplays when your browser allows it. Tap ♪ if it is quiet.</p>
                    }
                    else
                    {
                        <audio id="inviteAudio" src="@Model.MusicUrl" preload="auto" playsinline loop></audio>
                        <a class="inv-btn i18n" href="@Model.MusicUrl" target="_blank" rel="noopener" id="musicListenLink"
                           data-en="Listen" data-kh="ស្តាប់">Listen</a>
                    }
                </div>
            </section>
        }

        <section class="inv-section" id="rsvp">
            @{
                var isPreviewPage = string.Equals(
                    ViewContext.RouteData.Values["action"]?.ToString(),
                    "Preview",
                    StringComparison.OrdinalIgnoreCase);
                var rsvpReturn = isPreviewPage || string.IsNullOrWhiteSpace(Model.Slug)
                    ? $"/Website/Preview?weddingId={Model.WeddingId}"
                    : $"/w/{Model.Slug}";
            }
            <form class="rsvp-card" method="post" action="/w/@(Model.Slug)/rsvp">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@rsvpReturn" />
                <h2>RSVP</h2>
                @if (TempData["RsvpOk"] is string rsvpOk)
                {
                    <div class="rsvp-banner">@rsvpOk</div>
                }
                @if (TempData["RsvpError"] is string rsvpErr)
                {
                    <div class="rsvp-banner error">@rsvpErr</div>
                }
                <label class="field-label i18n" for="rsvpName" data-en="Your name" data-kh="ឈ្មោះរបស់អ្នក">Your name</label>
                <input id="rsvpName" name="fullName" type="text" required maxlength="150" autocomplete="name" />

                <label class="field-label i18n" for="rsvpEmail" data-en="Email (optional)" data-kh="អ៊ីមែល (ស្រេចចិត្ត)">Email (optional)</label>
                <input id="rsvpEmail" name="email" type="email" maxlength="150" autocomplete="email" />

                <label class="field-label i18n" data-en="Your reply" data-kh="ចម្លើយរបស់អ្នក">Your reply</label>
                <div class="rsvp-options">
                    <label class="rsvp-option">
                        <input type="radio" name="reply" value="Accepted" checked />
                        <span class="i18n" data-en="Joyfully accepts" data-kh="សូមទទួលយ៉ាងរីករាយ">Joyfully accepts</span>
                    </label>
                    <label class="rsvp-option">
                        <input type="radio" name="reply" value="Declined" />
                        <span class="i18n" data-en="Regretfully declines" data-kh="សូមអធ្យាស្រ័យ ទទួលមិនបាន">Regretfully declines</span>
                    </label>
                    <label class="rsvp-option">
                        <input type="radio" name="reply" value="Maybe" />
                        <span class="i18n" data-en="Not sure yet" data-kh="មិនទាន់ប្រាកដ">Not sure yet</span>
                    </label>
                </div>

                <label class="field-label i18n" for="rsvpMessage" data-en="Message (optional)" data-kh="សារ (ស្រេចចិត្ត)">Message (optional)</label>
                <textarea id="rsvpMessage" name="message" rows="3" maxlength="1000"></textarea>

                <label class="field-label i18n" for="rsvpDiet" data-en="Dietary notes (optional)" data-kh="ចំណាំអាហារ (ស្រេចចិត្ត)">Dietary notes (optional)</label>
                <input id="rsvpDiet" name="dietaryNotes" type="text" maxlength="300" />

                <button class="inv-btn rsvp-submit i18n" type="submit" data-en="Send RSVP" data-kh="ផ្ញើ RSVP">Send RSVP</button>
            </form>
        </section>

        <section class="inv-section" id="share">
            <h2 class="i18n" data-en="Share invite" data-kh="ចែករំលែកការអញ្ជើញ">Share invite</h2>
            <p class="inv-meta i18n" style="margin-top:0;"
               data-en="Send this page to family and friends."
               data-kh="ផ្ញើទំព័រនេះទៅក្រុមគ្រួសារ និងមិត្តភក្តិ។">Send this page to family and friends.</p>
            <div class="share-row">
                <button type="button" class="share-btn primary i18n" id="copyInviteBtn" data-url="@pageUrl"
                        data-en="Copy link" data-kh="ចម្លងតំណ">Copy link</button>
                <a class="share-btn" target="_blank" rel="noopener"
                   href="https://t.me/share/url?url=@Uri.EscapeDataString(pageUrl)&text=@Uri.EscapeDataString(title)">Telegram</a>
                <a class="share-btn" target="_blank" rel="noopener"
                   href="https://wa.me/?text=@Uri.EscapeDataString($"{title} — {pageUrl}")">WhatsApp</a>
                <a class="share-btn" target="_blank" rel="noopener"
                   href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(pageUrl)">Facebook</a>
            </div>
            <p class="share-hint" id="shareHint"></p>
        </section>

        <footer class="inv-thanks" id="thanks">
            <p class="inv-thanks-title i18n" data-en="Thank you" data-kh="អរគុណ">Thank you</p>
            <p class="inv-thanks-text i18n"
               data-en="We are so grateful to celebrate with you@(wedding is not null ? $" — with love, {wedding.CoupleDisplayName}" : ".")"
               data-kh="យើងរីករាយណាស់ដែលបានប្រារព្ធជាមួយអ្នក@(wedding is not null ? $" — ដោយសេចក្តីស្រលាញ់ {wedding.CoupleDisplayName}" : "។")">
                We are so grateful to celebrate with you
                @if (wedding is not null)
                {
                    <text> — with love, <strong>@wedding.CoupleDisplayName</strong></text>
                }
                else
                {
                    <text>.</text>
                }
            </p>
        </footer>
    </div>

    <nav class="inv-dock" aria-label="Quick links">
        <a class="inv-dock-home i18n" href="#home" data-en="Home" data-kh="ដើម">Home</a>
        @if (wedding is not null)
        {
            <a class="inv-dock-countdown i18n" href="#countdown" data-en="Countdown" data-kh="រាប់ថយ">Countdown</a>
        }
