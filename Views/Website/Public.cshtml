    @if (hasMusic)
    {
        <div class="music-float-tip is-on" id="musicTip">Tap for music</div>
        <button type="button" class="music-float" id="musicFloatBtn" aria-label="Play music">♪</button>
    }
    <button type="button" class="scroll-top" id="scrollTopBtn" aria-label="Back to top">↑</button>

    <script>
        (function () {
            var body = document.body;
            var langBar = document.getElementById('invLang');
            function setLang(lang) {
                lang = lang === 'kh' ? 'kh' : 'en';
                body.setAttribute('data-lang', lang);
                body.classList.toggle('lang-kh', lang === 'kh');
                document.querySelectorAll('.i18n').forEach(function (el) {
                    var text = el.getAttribute(lang === 'kh' ? 'data-kh' : 'data-en');
                    if (text == null || text === '') {
                        text = el.getAttribute('data-en') || el.getAttribute('data-kh');
                    }
                    if (text != null && text !== '') el.textContent = text;
                });
                document.querySelectorAll('.lang-panel.lang-en').forEach(function (el) {
                    el.hidden = lang === 'kh';
                });
                document.querySelectorAll('.lang-panel.lang-kh').forEach(function (el) {
                    el.hidden = lang !== 'kh';
                });
                if (langBar) {
                    langBar.querySelectorAll('button').forEach(function (btn) {
                        btn.classList.toggle('is-active', btn.getAttribute('data-lang') === lang);
                    });
                }
                try { localStorage.setItem('invite-lang', lang); } catch (e) { /* ignore */ }
            }
            if (langBar) {
                langBar.querySelectorAll('button').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        setLang(btn.getAttribute('data-lang'));
                    });
                });
                // Always open in English first
                setLang('en');
            }

            function initCarousel(root) {
                var slideSel = root.getAttribute('data-slide') || '.qr-slide';
                var slides = Array.prototype.slice.call(root.querySelectorAll(slideSel));
                if (!slides.length) return;
                var prevBtn = root.querySelector('[data-carousel-prev]');
                var nextBtn = root.querySelector('[data-carousel-next]');
                var counter = root.querySelector('[data-carousel-counter]');
                var download = root.querySelector('[data-carousel-download]');
                var i = 0;

                function show(n) {
                    i = (n + slides.length) % slides.length;
                    slides.forEach(function (s, idx) {
                        s.classList.toggle('active', idx === i);
                    });
                    if (counter) counter.textContent = (i + 1) + ' / ' + slides.length;
                    var active = slides[i];
                    if (download && active) {
                        download.href = active.getAttribute('data-src') || download.href;
                        download.setAttribute('download', active.getAttribute('data-name') || 'download.png');
                    }
                    if (prevBtn) prevBtn.disabled = slides.length <= 1;
                    if (nextBtn) nextBtn.disabled = slides.length <= 1;
                }

                var autoMs = parseInt(root.getAttribute('data-autoplay') || '0', 10);
                var timer = null;
                var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                function stopAuto() {
                    if (timer) {
                        clearInterval(timer);
                        timer = null;
                    }
                }

                function startAuto() {
                    stopAuto();
                    if (!autoMs || autoMs < 1000 || slides.length <= 1 || reduceMotion) return;
                    timer = setInterval(function () { show(i + 1); }, autoMs);
                }

                function go(n) {
                    show(n);
                    startAuto();
                }

                if (prevBtn) prevBtn.addEventListener('click', function () { go(i - 1); });
                if (nextBtn) nextBtn.addEventListener('click', function () { go(i + 1); });

                root.addEventListener('mouseenter', stopAuto);
                root.addEventListener('mouseleave', startAuto);
                root.addEventListener('focusin', stopAuto);
                root.addEventListener('focusout', startAuto);

                if (download) {
                    download.addEventListener('click', function (e) {
                        var active = slides[i];
                        if (!active) return;
                        var src = active.getAttribute('data-src');
                        var name = active.getAttribute('data-name') || 'download.png';
                        if (!src || (src.indexOf('http') === 0 && src.indexOf(location.origin) !== 0)) return;
                        e.preventDefault();
                        fetch(src).then(function (r) { return r.blob(); }).then(function (blob) {
                            var url = URL.createObjectURL(blob);
                            var a = document.createElement('a');
                            a.href = url;
                            a.download = name;
                            document.body.appendChild(a);
                            a.click();
                            a.remove();
                            URL.revokeObjectURL(url);
                        }).catch(function () {
                            window.open(src, '_blank');
                        });
                    });
                }

                show(0);
                startAuto();
            }

            document.querySelectorAll('[data-carousel]').forEach(initCarousel);

            (function initGallery3d() {
                var root = document.getElementById('gallery3d');
                if (!root) return;
                var stage = root.querySelector('[data-gallery-stage]');
                var cards = Array.prototype.slice.call(root.querySelectorAll('.gallery-3d-card'));
                if (!stage || !cards.length) return;

                var prevBtn = root.querySelector('[data-gallery-prev]');
                var nextBtn = root.querySelector('[data-gallery-next]');
                var counter = root.querySelector('[data-gallery-counter]');
                var caption = root.querySelector('[data-gallery-caption]');
                var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                var autoMs = parseInt(root.getAttribute('data-autoplay') || '0', 10);
                var active = 0;
                var timer = null;
                var n = cards.length;

                function wrapOffset(idx) {
                    var offset = idx - active;
                    if (n > 1) {
                        if (offset > n / 2) offset -= n;
                        if (offset < -n / 2) offset += n;
                    }
                    return offset;
                }

                function layout() {
                    var isNarrow = window.innerWidth < 560;
                    var stepX = isNarrow ? 38 : 46;
                    var stepZ = isNarrow ? 78 : 100;
                    var stepRot = isNarrow ? 16 : 24;

                    cards.forEach(function (card, idx) {
                        var offset = wrapOffset(idx);
                        var abs = Math.abs(offset);
                        var x = offset * stepX;
                        var z = -abs * stepZ;
                        var rotY = reduceMotion ? 0 : (-offset * stepRot);
                        var scale = Math.max(0.55, 1 - abs * 0.14);
                        var blur = reduceMotion || abs === 0 ? 0 : Math.min(abs * 2.2, 7);
                        var opacity = abs > 3 ? 0 : Math.max(0.25, 1 - abs * 0.22);

                        if (reduceMotion) {
                            card.style.transform = 'translate(-50%, -50%) scale(' + (abs === 0 ? 1 : 0.86) + ')';
                            card.style.filter = 'none';
                            card.style.opacity = abs === 0 ? '1' : '0';
                            card.style.pointerEvents = abs === 0 ? 'auto' : 'none';
                        } else {
                            card.style.transform =
                                'translate(-50%, -50%) translateX(' + x + '%) translateZ(' + z + 'px) rotateY(' + rotY + 'deg) scale(' + scale + ')';
                            card.style.filter = blur ? 'blur(' + blur + 'px)' : 'none';
                            card.style.opacity = String(opacity);
                            card.style.pointerEvents = abs <= 2 ? 'auto' : 'none';
                        }

                        card.style.zIndex = String(100 - Math.round(abs * 10));
                        card.classList.toggle('is-active', offset === 0);
                        card.classList.toggle('is-far', abs > 2);
                        card.setAttribute('aria-hidden', offset === 0 ? 'false' : 'true');
                    });

                    if (counter) counter.textContent = (active + 1) + ' / ' + n;
                    if (caption) {
                        var label = cards[active].getAttribute('data-label') || ('Photo ' + (active + 1));
                        caption.textContent = label;
                    }
                    if (prevBtn) prevBtn.disabled = n <= 1;
                    if (nextBtn) nextBtn.disabled = n <= 1;
                }

                function go(delta) {
                    if (n <= 1) return;
                    active = (active + delta + n) % n;
                    layout();
                    startAuto();
                }

                function stopAuto() {
                    if (timer) {
                        clearInterval(timer);
                        timer = null;
                    }
                }

                function startAuto() {
                    stopAuto();
                    if (!autoMs || autoMs < 1000 || n <= 1 || reduceMotion) return;
                    timer = setInterval(function () { go(1); }, autoMs);
                }

                if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); });
                if (nextBtn) nextBtn.addEventListener('click', function () { go(1); });

                cards.forEach(function (card) {
                    card.addEventListener('click', function () {
                        var idx = parseInt(card.getAttribute('data-index') || '0', 10);
                        if (idx === active) return;
                        active = idx;
                        layout();
                        startAuto();
                    });
                });

                var touchX = null;
                stage.addEventListener('touchstart', function (e) {
                    if (!e.changedTouches || !e.changedTouches.length) return;
                    touchX = e.changedTouches[0].clientX;
                    stopAuto();
                }, { passive: true });
                stage.addEventListener('touchend', function (e) {
                    if (touchX == null || !e.changedTouches || !e.changedTouches.length) return;
                    var dx = e.changedTouches[0].clientX - touchX;
                    touchX = null;
                    if (Math.abs(dx) < 36) {
                        startAuto();
                        return;
                    }
                    go(dx < 0 ? 1 : -1);
                }, { passive: true });

                root.addEventListener('mouseenter', stopAuto);
                root.addEventListener('mouseleave', startAuto);
                window.addEventListener('resize', layout);

                layout();
                startAuto();
            })();

            // Back to top
            (function () {
                var btn = document.getElementById('scrollTopBtn');
                if (!btn) return;
                function sync() {
                    btn.classList.toggle('is-on', window.scrollY > 420);
                }
                window.addEventListener('scroll', sync, { passive: true });
                btn.addEventListener('click', function () {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
                sync();
            })();

            // Music autoplay (browsers often need one tap)
            (function () {
                var iframe = document.getElementById('spotifyPlayer');
                var audio = document.getElementById('inviteAudio');
                var btn = document.getElementById('musicFloatBtn');
                var tip = document.getElementById('musicTip');
                if (!iframe && !audio) return;

                var started = false;

                function hideTip() {
                    if (tip) tip.classList.remove('is-on');
                }

                function startSpotify() {
                    if (!iframe || started) return;
                    started = true;
                    hideTip();
                    if (btn) btn.classList.add('is-playing');
                    var src = iframe.getAttribute('src') || '';
                    if (src.indexOf('autoplay=1') === -1) {
                        src += (src.indexOf('?') >= 0 ? '&' : '?') + 'autoplay=1';
                    }
                    // Reload embed after a user gesture so autoplay is more likely to work
                    iframe.src = src;
                }

                function startAudio() {
                    if (!audio || started) return;
                    audio.play().then(function () {
                        started = true;
                        hideTip();
                        if (btn) btn.classList.add('is-playing');
                    }).catch(function () { /* wait for tap */ });
                }

                function tryPlay() {
                    if (iframe) startSpotify();
                    else startAudio();
                }

                if (btn) {
                    btn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        if (iframe) {
                            started = false;
                            startSpotify();
                        } else if (audio) {
                            if (!audio.paused) {
                                audio.pause();
                                btn.classList.remove('is-playing');
                                started = false;
                            } else {
                                started = false;
                                startAudio();
                            }
                        }
                    });
                }

                // After loading screen, first tap anywhere can unlock music
                function onFirstGesture() {
                    tryPlay();
                    document.removeEventListener('pointerdown', onFirstGesture);
                    document.removeEventListener('keydown', onFirstGesture);
                }
                document.addEventListener('pointerdown', onFirstGesture, { once: true });
                document.addEventListener('keydown', onFirstGesture, { once: true });

                // Try once the invite is revealed (may still be blocked without gesture)
                var watch = setInterval(function () {
                    if (!document.body.classList.contains('inv-ready')) return;
                    clearInterval(watch);
                    setTimeout(function () {
                        if (audio) startAudio();
                        // Spotify still needs gesture in most browsers; tip stays visible
                    }, 400);
                }, 200);
            })();

            // Countdown
            (function () {
                var grid = document.getElementById('countdownGrid');
                var done = document.getElementById('countdownDone');
                if (!grid) return;
                var dateStr = grid.getAttribute('data-wedding-date');
                if (!dateStr) return;
                var target = new Date(dateStr + 'T00:00:00');
                var daysEl = grid.querySelector('[data-cd="days"]');
                var hoursEl = grid.querySelector('[data-cd="hours"]');
                var minsEl = grid.querySelector('[data-cd="mins"]');
                var secsEl = grid.querySelector('[data-cd="secs"]');

                function tick() {
                    var now = new Date();
                    var diff = target.getTime() - now.getTime();
                    if (diff <= 0) {
                        grid.hidden = true;
                        if (done) done.hidden = false;
                        return;
                    }
                    grid.hidden = false;
                    if (done) done.hidden = true;
                    var secs = Math.floor(diff / 1000);
                    var days = Math.floor(secs / 86400);
                    secs -= days * 86400;
                    var hours = Math.floor(secs / 3600);
                    secs -= hours * 3600;
                    var mins = Math.floor(secs / 60);
                    secs -= mins * 60;
                    if (daysEl) daysEl.textContent = String(days);
                    if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
                    if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
                    if (secsEl) secsEl.textContent = String(secs).padStart(2, '0');
                }
                tick();
                setInterval(tick, 1000);
            })();

            // Add to calendar (.ics)
            (function () {
                var btn = document.getElementById('addToCalendarBtn');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    var title = btn.getAttribute('data-title') || 'Wedding';
                    var date = (btn.getAttribute('data-date') || '').replace(/-/g, '');
                    var venue = btn.getAttribute('data-venue') || '';
                    var desc = btn.getAttribute('data-desc') || '';
                    if (!date) return;
                    var ics = [
                        'BEGIN:VCALENDAR',
                        'VERSION:2.0',
                        'PRODID:-//Wedding Invite//EN',
                        'BEGIN:VEVENT',
                        'DTSTART;VALUE=DATE:' + date,
                        'DTEND;VALUE=DATE:' + date,
                        'SUMMARY:' + title.replace(/\n/g, ' '),
                        'DESCRIPTION:' + desc.replace(/\n/g, ' '),
                        'LOCATION:' + venue.replace(/\n/g, ' '),
                        'END:VEVENT',
                        'END:VCALENDAR'
                    ].join('\r\n');
                    var blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = 'wedding.ics';
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    URL.revokeObjectURL(url);
                });
            })();

            // Copy invite link
            (function () {
                var btn = document.getElementById('copyInviteBtn');
                var hint = document.getElementById('shareHint');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    var url = btn.getAttribute('data-url') || location.href;
                    function ok() {
                        if (hint) hint.textContent = 'Link copied!';
                        setTimeout(function () { if (hint) hint.textContent = ''; }, 2500);
                    }
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(url).then(ok).catch(function () {
                            window.prompt('Copy this link:', url);
                        });
                    } else {
                        window.prompt('Copy this link:', url);
                    }
                });
            })();

            // Scroll reveal — animate in when entering viewport, out when leaving
            var revealEls = document.querySelectorAll('.inv-hero, .inv-section, .octagon-item');
            if (revealEls.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                        } else {
                            entry.target.classList.remove('is-visible');
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

                revealEls.forEach(function (el) { io.observe(el); });
            } else {
                revealEls.forEach(function (el) { el.classList.add('is-visible'); });
            }

            // Highlight dock link for the section in view
            var dock = document.querySelector('.inv-dock');
            if (dock) {
                var links = Array.prototype.slice.call(dock.querySelectorAll('a[href^="#"]'));
                var targets = links.map(function (a) {
                    return document.getElementById(a.getAttribute('href').slice(1));
                }).filter(Boolean);

                if (targets.length) {
                    var dockIo = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (!entry.isIntersecting) return;
                            var id = entry.target.id;
                            links.forEach(function (a) {
                                a.classList.toggle('is-active', a.getAttribute('href') === '#' + id);
                            });
                        });
                    }, { threshold: 0.35, rootMargin: '-20% 0px -45% 0px' });
                    targets.forEach(function (t) { dockIo.observe(t); });
                }
            }
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.136.0/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script>
        (function () {
            var body = document.body;
            var loader = document.getElementById('invLoader');
            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var effectStyle = parseInt(body.getAttribute('data-effect') || '0', 10);

            var finished = false;
            var snowStarted = false;

            var effectPalette = {
                0: { color: 0xee5282, size: 3 },
                1: { color: 0xee5282, size: 3 },
                2: { color: 0xf4729b, size: 3.2 },
                3: { color: 0xe8f1ff, size: 2.6 },
                4: { color: 0xe11d48, size: 3.1 },
                5: { color: 0xf5d78e, size: 2.8 }
            };
            var palette = effectPalette[effectStyle] || effectPalette[1];

            function startInviteEffect() {
                if (snowStarted) return;
                snowStarted = true;
                var layer = document.getElementById('heartSnow');
                if (!layer || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

                var effect = parseInt(layer.getAttribute('data-effect') || body.getAttribute('data-effect') || '0', 10);
                if (!effect || effect === 0) {
                    layer.classList.remove('has-effect');
                    layer.innerHTML = '';
                    return;
                }

                layer.classList.add('has-effect');
                var count = window.innerWidth < 700 ? 28 : 46;
                var hearts = ['♥', '❤', '❥'];
                layer.innerHTML = '';

                for (var n = 0; n < count; n++) {
                    var el = document.createElement('span');
                    var kind = 'snow';

                    if (effect === 1) kind = Math.random() > 0.38 ? 'heart' : 'snow';
                    else if (effect === 2) kind = 'heart';
                    else if (effect === 3) kind = 'snow';
                    else if (effect === 4) kind = 'petal';
                    else if (effect === 5) kind = Math.random() > 0.45 ? 'sparkle' : 'star';

                    if (kind === 'heart') {
                        el.className = 'fall-item fall-heart';
                        el.textContent = hearts[n % hearts.length];
                        el.style.fontSize = (0.7 + Math.random() * 1.1) + 'rem';
                        if (Math.random() > 0.55) el.classList.add('is-soft');
                        else if (Math.random() > 0.7) el.classList.add('is-deep');
                    } else if (kind === 'petal') {
                        el.className = 'fall-item fall-petal';
                        if (Math.random() > 0.5) el.classList.add('is-soft');
                        var size = 10 + Math.random() * 10;
                        el.style.width = size + 'px';
                        el.style.height = (size * 1.25) + 'px';
                    } else if (kind === 'sparkle' || kind === 'star') {
                        el.className = 'fall-item fall-sparkle' + (kind === 'star' ? ' is-star' : '');
                        if (kind === 'star') {
                            el.textContent = '✦';
                            el.style.fontSize = (0.55 + Math.random() * 0.7) + 'rem';
                        } else {
                            var spark = 3 + Math.random() * 5;
                            el.style.width = spark + 'px';
                            el.style.height = spark + 'px';
                        }
                    } else {
                        el.className = 'fall-item fall-snow';
                        var flake = 3 + Math.random() * 6;
                        el.style.width = flake + 'px';
                        el.style.height = flake + 'px';
                        if (effect === 1 && Math.random() > 0.5) el.classList.add('is-pink');
                    }

                    el.style.left = (Math.random() * 100) + 'vw';
                    el.style.setProperty('--drift', (Math.random() * 80 - 40) + 'px');
                    el.style.setProperty('--spin', (Math.random() * 360 - 180) + 'deg');
                    el.style.animationDuration = (7 + Math.random() * 10) + 's';
                    el.style.animationDelay = (Math.random() * -14) + 's';
                    el.style.opacity = String(0.45 + Math.random() * 0.5);
                    layer.appendChild(el);
                }
            }

            function finishLoading() {
                if (finished) return;
                finished = true;
                if (loader) loader.classList.add('is-done');
                body.classList.remove('inv-loading');
                body.classList.add('inv-ready');
                startInviteEffect();
            }

            // Same falling style as chosen effect — visible during loading too
            if (!reduceMotion && effectStyle > 0) {
                startInviteEffect();
            }

            if (reduceMotion || typeof THREE === 'undefined' || typeof gsap === 'undefined') {
                finishLoading();
                return;
            }

            var host = document.getElementById('heartBg');
            var path = document.getElementById('heartPath');
            if (!host || !path || !path.getTotalLength) {
                finishLoading();
                return;
            }

            var scene = new THREE.Scene();
            var camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 5000);
            camera.position.z = 500;

            var renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setClearColor(0x000000, 0);
            host.appendChild(renderer.domElement);

            var length = path.getTotalLength();
            var step = window.innerWidth < 700 ? 0.45 : 0.18;
            var vertices = [];
            var jitter = effectStyle === 5 ? 42 : (effectStyle === 3 ? 22 : 30);

            for (var i = 0; i < length; i += step) {
                var point = path.getPointAtLength(i);
                var vector = new THREE.Vector3(point.x, -point.y, 0);
                vector.x += (Math.random() - 0.5) * jitter;
                vector.y += (Math.random() - 0.5) * jitter;
                vector.z += (Math.random() - 0.5) * (effectStyle === 5 ? 90 : 70);
                vertices.push(vector);
            }

            var geometry = new THREE.BufferGeometry().setFromPoints(vertices);
            var material = new THREE.PointsMaterial({
                color: palette.color,
                blending: THREE.AdditiveBlending,
                transparent: true,
                depthWrite: false,
                size: (window.innerWidth < 700 ? palette.size * 0.75 : palette.size)
            });
            var particles = new THREE.Points(geometry, material);
            particles.position.x -= 600 / 2;
            particles.position.y += 552 / 2;
            scene.add(particles);

            var tl = gsap.timeline({
                onComplete: function () {
                    setTimeout(finishLoading, 650);
                    gsap.to(particles.scale, {
                        x: 1.04, y: 1.04, z: 1.04,
                        duration: 2.2,
                        yoyo: true,
                        repeat: -1,
                        ease: 'power1.inOut'
                    });
                }
            });

            for (var j = 0; j < vertices.length; j++) {
                tl.from(vertices[j], {
                    x: 600 / 2,
                    y: -552 / 2,
                    z: 0,
                    ease: 'power2.out',
                    duration: 'random(1.6, 3.2)'
                }, j * step * 0.0015);
            }

            gsap.fromTo(scene.rotation, { y: -0.15 }, {
                y: 0.15,
                repeat: -1,
                yoyo: true,
                ease: 'power2.inOut',
                duration: 3
            });

            setTimeout(finishLoading, 5000);

            function render() {
                requestAnimationFrame(render);
                geometry.setFromPoints(vertices);
                renderer.render(scene, camera);
            }

            function onWindowResize() {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            }
            window.addEventListener('resize', onWindowResize, false);
            requestAnimationFrame(render);
        })();
    </script>
    <input type="hidden" data-web="@(wedding?.WebId ?? 0)" data-partner="@(Model.Slug ?? "")" />
</body>
</html>
