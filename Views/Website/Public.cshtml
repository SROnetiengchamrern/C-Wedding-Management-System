@using WeddingManagementSystem.Models
@model WebsiteSettings
@{
    Layout = null;
    var theme = InviteThemes.Get(Model.ThemeLayout);
    var title = Model.SiteTitle;
    var description = !string.IsNullOrWhiteSpace(Model.ShareDescription)
        ? Model.ShareDescription
        : Model.WelcomeMessage ?? "You're invited to our wedding.";
    var image = !string.IsNullOrWhiteSpace(Model.ShareImageUrl) ? Model.ShareImageUrl : Model.CoverImageUrl;
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/w/{Model.Slug}";
    var wedding = Model.Wedding;
    var mapQueryRaw = Model.MapSearch;
    if (string.IsNullOrWhiteSpace(mapQueryRaw) && wedding is not null)
    {
        mapQueryRaw = string.IsNullOrWhiteSpace(wedding.VenueLocation)
            ? wedding.VenueName
            : $"{wedding.VenueName}, {wedding.VenueLocation}";
    }
    var mapQuery = Uri.EscapeDataString(mapQueryRaw ?? "");
    var isSpotify = !string.IsNullOrWhiteSpace(Model.MusicUrl) &&
        Model.MusicUrl.Contains("spotify.com", StringComparison.OrdinalIgnoreCase);
    string? spotifyEmbed = null;
    if (isSpotify && Model.MusicUrl is not null)
    {
        spotifyEmbed = Model.MusicUrl
            .Replace("open.spotify.com/", "open.spotify.com/embed/")
            .Split('?')[0];
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@pageUrl" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:site_name" content="Wedding Invitation" />
    @if (!string.IsNullOrWhiteSpace(image))
    {
        <meta property="og:image" content="@image" />
    }
    <meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(image) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    @if (!string.IsNullOrWhiteSpace(image))
    {
        <meta name="twitter:image" content="@image" />
    }
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --inv-primary: @theme.Primary;
            --inv-accent: @theme.Accent;
            --inv-bg: @theme.Bg;
            --inv-card: @theme.Card;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Source Sans 3", sans-serif;
            background: var(--inv-bg);
            color: @(theme.Id == 3 ? "#f3eadc" : "#2c241c");
            min-height: 100vh;
        }
        .inv-wrap { max-width: 720px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
        .inv-hero {
            border-radius: 18px;
            overflow: hidden;
            background: var(--inv-card);
            border: 1px solid color-mix(in srgb, var(--inv-primary) 18%, transparent);
            box-shadow: 0 16px 40px rgba(0,0,0,.06);
            text-align: center;
        }
        .inv-cover { width: 100%; max-height: 360px; object-fit: cover; display: block; }
        .inv-body { padding: 1.75rem 1.4rem 2rem; }
        .inv-badge {
            display: inline-block;
            font-size: .72rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--inv-primary);
            background: color-mix(in srgb, var(--inv-accent) 18%, transparent);
            padding: .25rem .6rem;
            border-radius: 999px;
            margin-bottom: .85rem;
        }
        h1 {
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(2.2rem, 7vw, 3.6rem);
            margin: 0 0 .4rem;
            color: var(--inv-primary);
            line-height: 1.1;
        }
        .inv-meta { opacity: .75; margin: 0 0 1rem; }
        .inv-msg { line-height: 1.55; margin: 0 0 1.25rem; }
        .inv-btn {
            display: inline-block;
            background: linear-gradient(180deg, var(--inv-accent), var(--inv-primary));
            color: #fff;
            text-decoration: none;
            padding: .7rem 1.35rem;
            border-radius: 999px;
            font-weight: 600;
        }
        .inv-section { margin-top: 1.35rem; }
        .inv-section h2 {
            font-family: "Cormorant Garamond", serif;
            color: var(--inv-primary);
            font-size: 1.55rem;
            margin: 0 0 .75rem;
        }

        /* Scroll reveal (up & down) */
        .inv-hero,
        .inv-section {
            opacity: 0;
            transform: translateY(28px);
            transition-property: opacity, transform;
            transition-duration: 400ms, 440ms;
            transition-delay: 0ms, 0ms;
            transition-timing-function: cubic-bezier(0.4, 0, 1, 1), cubic-bezier(0.4, 0, 0.72, 1);
            will-change: opacity, transform;
        }
        .inv-hero.is-visible,
        .inv-section.is-visible {
            opacity: 1;
            transform: translateY(0);
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1), cubic-bezier(0.22, 1, 0.36, 1);
        }
        @@media (prefers-reduced-motion: reduce) {
            .inv-hero,
            .inv-section,
            .octagon-item {
                opacity: 1;
                transform: none;
                transition: none;
            }
        }

        /* Footer octagon gallery */
        .inv-footer-gallery {
            margin-top: 2.25rem;
            padding: 1.75rem 1rem 2rem;
            border-radius: 18px;
            background: color-mix(in srgb, var(--inv-accent) 10%, var(--inv-bg));
            border: 1px solid color-mix(in srgb, var(--inv-primary) 12%, transparent);
            text-align: center;
        }
        .inv-footer-gallery h2 {
            font-family: "Cormorant Garamond", serif;
            color: var(--inv-primary);
            font-size: 1.55rem;
            margin: 0 0 1.15rem;
        }
        .octagon-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem 1.1rem;
            justify-items: center;
            max-width: 560px;
            margin: 0 auto;
        }
        .octagon-item {
            width: 100%;
            max-width: 110px;
            aspect-ratio: 1;
            opacity: 0;
            transform: translateY(20px) scale(.94);
            transition-property: opacity, transform;
            transition-duration: 400ms, 440ms;
            transition-delay: 0ms, 0ms;
            transition-timing-function: cubic-bezier(0.4, 0, 1, 1), cubic-bezier(0.4, 0, 0.72, 1);
            will-change: opacity, transform;
        }
        .octagon-item.is-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1), cubic-bezier(0.22, 1, 0.36, 1);
        }
        .octagon-item:nth-child(1) { transition-delay: 0ms, 0ms; }
        .octagon-item:nth-child(2) { transition-delay: 40ms, 40ms; }
        .octagon-item:nth-child(3) { transition-delay: 80ms, 80ms; }
        .octagon-item:nth-child(4) { transition-delay: 120ms, 120ms; }
        .octagon-item:nth-child(5) { transition-delay: 60ms, 60ms; }
        .octagon-item:nth-child(6) { transition-delay: 100ms, 100ms; }
        .octagon-item:nth-child(7) { transition-delay: 140ms, 140ms; }
        .octagon-item:nth-child(8) { transition-delay: 180ms, 180ms; }
        .octagon-frame {
            width: 100%;
            height: 100%;
            clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);
            overflow: hidden;
            background: var(--inv-card);
            filter: drop-shadow(0 8px 16px rgba(44, 36, 28, .16));
        }
        .octagon-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        .octagon-item:hover .octagon-frame img {
            transform: scale(1.06);
        }
        @@media (max-width: 560px) {
            .octagon-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: .85rem;
            }
            .octagon-item { max-width: 140px; }
        }

        .gallery-carousel {
            background: var(--inv-card);
            border-radius: 16px;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 15%, transparent);
            padding: 1rem 1rem 1.15rem;
            text-align: center;
        }
        .gallery-slides { position: relative; min-height: 220px; }
        .gallery-slide {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: .55rem;
            animation: invFade .25s ease;
        }
        .gallery-slide.active { display: flex; }
        .gallery-slide img {
            width: 100%;
            max-height: 320px;
            object-fit: cover;
            border-radius: 12px;
            background: #fff;
        }
        .gallery-slide figcaption {
            font-size: .9rem;
            opacity: .8;
            margin: 0;
        }
        .qr-carousel {
            background: var(--inv-card);
            border-radius: 16px;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 15%, transparent);
            padding: 1rem 1rem 1.15rem;
            text-align: center;
        }
        .qr-slides { position: relative; min-height: 220px; }
        .qr-slide {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: .55rem;
            animation: invFade .25s ease;
        }
        .qr-slide.active { display: flex; }
        .qr-slide img {
            width: min(100%, 280px);
            height: auto;
            border-radius: 12px;
            background: #fff;
        }
        .qr-slide figcaption {
            font-size: .9rem;
            opacity: .8;
            margin: 0;
        }
        @@keyframes invFade {
            from { opacity: .35; transform: translateY(4px); }
            to { opacity: 1; transform: none; }
        }
        .inv-carousel-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .55rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }
        .inv-carousel-controls button,
        .qr-download {
            appearance: none;
            border: 1px solid color-mix(in srgb, var(--inv-primary) 35%, transparent);
            background: #fff;
            color: var(--inv-primary);
            font: inherit;
            font-weight: 600;
            padding: .5rem 1rem;
            border-radius: 999px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }
        .inv-carousel-controls button:disabled {
            opacity: .4;
            cursor: not-allowed;
        }
        .qr-download {
            background: linear-gradient(180deg, var(--inv-accent), var(--inv-primary));
            color: #fff;
            border-color: transparent;
        }
        .inv-carousel-counter {
            font-size: .88rem;
            opacity: .75;
            min-width: 3.5rem;
        }
        .music-box { margin-top: .5rem; }
        .music-box iframe { width: 100%; height: 80px; border-radius: 12px; border: 0; }
        .map-frame {
            border: 0;
            width: 100%;
            height: 260px;
            border-radius: 14px;
            background: #ddd;
        }
        .rsvp-card {
            background: var(--inv-card);
            border: 1px solid color-mix(in srgb, var(--inv-primary) 15%, transparent);
            border-radius: 16px;
            padding: 1.25rem 1.15rem 1.35rem;
            box-shadow: 0 10px 28px rgba(0,0,0,.04);
        }
        .rsvp-card h2 { margin-top: 0; }
        .rsvp-card label.field-label {
            display: block;
            font-weight: 600;
            margin: .85rem 0 .35rem;
        }
        .rsvp-card input[type="text"],
        .rsvp-card input[type="email"],
        .rsvp-card textarea {
            width: 100%;
            border: 1px solid #e5e0da;
            border-radius: 10px;
            padding: .65rem .75rem;
            background: #fff;
            color: inherit;
            font: inherit;
        }
        .rsvp-card input:focus,
        .rsvp-card textarea:focus {
            outline: none;
            border-color: var(--inv-primary);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--inv-primary) 18%, transparent);
        }
        .rsvp-options { display: flex; flex-direction: column; gap: .45rem; }
        .rsvp-option {
            display: flex;
            align-items: center;
            gap: .55rem;
            border: 1px solid #e5e0da;
            border-radius: 12px;
            padding: .7rem .85rem;
            background: #fff;
            cursor: pointer;
        }
        .rsvp-option:has(input:checked) {
            background: color-mix(in srgb, var(--inv-accent) 16%, #fff);
            border-color: var(--inv-primary);
        }
        .rsvp-submit {
            width: 100%;
            margin-top: 1rem;
            border: 0;
            cursor: pointer;
            text-align: center;
        }
        .rsvp-banner {
            border-radius: 12px;
            padding: .7rem .85rem;
            margin-bottom: .85rem;
            background: color-mix(in srgb, var(--inv-accent) 18%, #fff);
            color: var(--inv-primary);
            font-weight: 600;
        }
        .rsvp-banner.error { background: #fde8e8; color: #8a1f1f; }

        /* Fixed quick-nav dock */
        html { scroll-behavior: smooth; }
        body { padding-bottom: 5.5rem; }
        .inv-dock {
            position: fixed;
            left: 50%;
            bottom: 1.1rem;
            transform: translateX(-50%);
            z-index: 50;
            display: flex;
            align-items: center;
            gap: .45rem;
            padding: .4rem .5rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, .94);
            border: 1px solid rgba(255, 255, 255, .8);
            box-shadow:
                0 0 0 1px rgba(80, 60, 90, .06),
                0 10px 28px rgba(60, 40, 70, .16),
                0 0 24px rgba(180, 160, 210, .35);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            max-width: calc(100vw - 1.25rem);
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .inv-dock::-webkit-scrollbar { display: none; }
        .inv-dock a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2.35rem;
            padding: .45rem 1.05rem;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-decoration: none;
            text-transform: uppercase;
            white-space: nowrap;
            transition: transform 180ms ease, filter 180ms ease;
        }
        .inv-dock a:hover { transform: translateY(-1px); filter: brightness(.97); }
        .inv-dock a:active { transform: translateY(0); }
        .inv-dock a.is-active { box-shadow: inset 0 0 0 1.5px currentColor; }
        .inv-dock-gallery {
            background: #d9d6ef;
            color: #3b2f5c;
        }
        .inv-dock-rsvp {
            background: #f3c9c5;
            color: #6b2c2c;
        }
        .inv-dock-bank {
            background: #f3e2b0;
            color: #5c4520;
        }
        .inv-dock-home {
            background: #d8ebe3;
            color: #1f4d3d;
        }
        .inv-dock-map {
            background: #d4e4f5;
            color: #1e3f66;
        }
        .inv-dock-music {
            background: #ecd9f2;
            color: #5a2d6b;
        }
        .inv-dock-moments {
            background: #f5ddd0;
            color: #6b3a28;
        }
        @@media (max-width: 420px) {
            .inv-dock { gap: .3rem; padding: .35rem .4rem; }
            .inv-dock a { padding: .42rem .72rem; font-size: .68rem; letter-spacing: .04em; }
        }
    </style>
</head>
<body>
    <div class="inv-wrap">
        <article class="inv-hero" id="home">
            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl ?? image))
            {
                <img class="inv-cover" src="@(Model.CoverImageUrl ?? image)" alt="@title" />
            }
            <div class="inv-body">
                <div class="inv-badge">@(Model.IsPublished ? "You're invited" : "Draft preview")</div>
                <h1>@title</h1>
                @if (wedding is not null)
                {
                    <p class="inv-meta">
                        @wedding.WeddingDate.ToString("MMMM d, yyyy")
                        @if (!string.IsNullOrWhiteSpace(wedding.VenueName))
                        {
                            <text> · @wedding.VenueName</text>
                            @if (!string.IsNullOrWhiteSpace(wedding.VenueLocation))
                            {
                                <text>, @wedding.VenueLocation</text>
                            }
                        }
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.WelcomeMessage))
                {
                    <p class="inv-msg">@Model.WelcomeMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.InviteMessage))
                {
                    <p class="inv-msg">@Model.InviteMessage</p>
                }
            </div>
        </article>

        @if (Model.GalleryPhotos.Any())
        {
            var galleryList = Model.GalleryPhotos.ToList();
            <section class="inv-section" id="gallery">
                <h2>Gallery</h2>
                <div class="gallery-carousel" data-carousel data-slide=".gallery-slide">
                    <div class="gallery-slides">
                        @for (var i = 0; i < galleryList.Count; i++)
                        {
                            var p = galleryList[i];
                            <figure class="gallery-slide @(i == 0 ? "active" : "")">
                                <img src="@p.FilePath" alt="@p.Label" />
                                <figcaption>@p.Label</figcaption>
                            </figure>
                        }
                    </div>
                    <div class="inv-carousel-controls">
                        <button type="button" data-carousel-prev aria-label="Previous photo">‹ Prev</button>
                        <span class="inv-carousel-counter" data-carousel-counter>1 / @galleryList.Count</span>
                        <button type="button" data-carousel-next aria-label="Next photo">Next ›</button>
                    </div>
                </div>
            </section>
        }

        @if (Model.BankQrs.Any())
        {
            var qrList = Model.BankQrs.ToList();
            <section class="inv-section" id="bank-qr">
                <h2>Bank transfer QR</h2>
                <div class="qr-carousel" data-carousel data-slide=".qr-slide" data-has-download="true">
                    <div class="qr-slides">
                        @for (var i = 0; i < qrList.Count; i++)
                        {
                            var q = qrList[i];
                            var fileName = System.IO.Path.GetFileName(q.FilePath) ?? $"bank-qr-{i + 1}.png";
                            <figure class="qr-slide @(i == 0 ? "active" : "")" data-src="@q.FilePath" data-name="@fileName">
                                <img src="@q.FilePath" alt="@q.Label" />
                                <figcaption>@q.Label</figcaption>
                            </figure>
                        }
                    </div>
                    <div class="inv-carousel-controls">
                        <button type="button" data-carousel-prev aria-label="Previous QR">‹ Prev</button>
                        <span class="inv-carousel-counter" data-carousel-counter>1 / @qrList.Count</span>
                        <button type="button" data-carousel-next aria-label="Next QR">Next ›</button>
                        <a class="qr-download" data-carousel-download href="@qrList[0].FilePath" download="@(System.IO.Path.GetFileName(qrList[0].FilePath) ?? "bank-qr.png")">Download</a>
                    </div>
                </div>
            </section>
        }

        @if (Model.ShowMap && !string.IsNullOrWhiteSpace(mapQuery))
        {
            <section class="inv-section" id="map">
                <h2>Venue map</h2>
                <iframe class="map-frame" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                        src="https://maps.google.com/maps?q=@mapQuery&z=15&output=embed"
                        title="Venue map"></iframe>
                <p style="margin:.5rem 0 0;">
                    <a class="inv-btn" style="padding:.45rem 1rem;font-size:.9rem;" href="https://www.google.com/maps/search/?api=1&query=@mapQuery" target="_blank" rel="noopener">Open in Google Maps</a>
                </p>
            </section>
        }
        else if (!Model.ShowMap && wedding is not null && !string.IsNullOrWhiteSpace(wedding.VenueName))
        {
            <section class="inv-section" id="map">
                <h2>Venue</h2>
                <p class="inv-meta">@wedding.VenueName@(string.IsNullOrWhiteSpace(wedding.VenueLocation) ? "" : $", {wedding.VenueLocation}")</p>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.MusicUrl))
        {
            <section class="inv-section" id="music">
                <h2>Music</h2>
                <div class="music-box">
                    @if (spotifyEmbed is not null)
                    {
                        <iframe src="@spotifyEmbed" allow="encrypted-media" loading="lazy"></iframe>
                    }
                    else
                    {
                        <a class="inv-btn" href="@Model.MusicUrl" target="_blank" rel="noopener">Listen</a>
                    }
                </div>
            </section>
        }

        <section class="inv-section" id="rsvp">
            @{
                var isPreviewPage = string.Equals(
                    ViewContext.RouteData.Values["action"]?.ToString(),
                    "Preview",
                    StringComparison.OrdinalIgnoreCase);
                var rsvpReturn = isPreviewPage || string.IsNullOrWhiteSpace(Model.Slug)
                    ? $"/Website/Preview?weddingId={Model.WeddingId}"
                    : $"/w/{Model.Slug}";
            }
            <form class="rsvp-card" method="post" action="/w/@(Model.Slug)/rsvp">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@rsvpReturn" />
                <h2>RSVP</h2>
                @if (TempData["RsvpOk"] is string rsvpOk)
                {
                    <div class="rsvp-banner">@rsvpOk</div>
                }
                @if (TempData["RsvpError"] is string rsvpErr)
                {
                    <div class="rsvp-banner error">@rsvpErr</div>
                }
                <label class="field-label" for="rsvpName">Your name</label>
                <input id="rsvpName" name="fullName" type="text" required maxlength="150" autocomplete="name" />

                <label class="field-label" for="rsvpEmail">Email (optional)</label>
                <input id="rsvpEmail" name="email" type="email" maxlength="150" autocomplete="email" />

                <label class="field-label">Your reply</label>
                <div class="rsvp-options">
                    <label class="rsvp-option">
                        <input type="radio" name="reply" value="Accepted" checked /> Joyfully accepts
                    </label>
                    <label class="rsvp-option">
                        <input type="radio" name="reply" value="Declined" /> Regretfully declines
                    </label>
                    <label class="rsvp-option">
                        <input type="radio" name="reply" value="Maybe" /> Not sure yet
                    </label>
                </div>

                <label class="field-label" for="rsvpMessage">Message (optional)</label>
                <textarea id="rsvpMessage" name="message" rows="3" maxlength="1000"></textarea>

                <label class="field-label" for="rsvpDiet">Dietary notes (optional)</label>
                <input id="rsvpDiet" name="dietaryNotes" type="text" maxlength="300" />

                <button class="inv-btn rsvp-submit" type="submit">Send RSVP</button>
            </form>
        </section>

        @if (Model.GalleryPhotos.Any())
        {
            var footerPhotos = Model.GalleryPhotos.OrderBy(p => p.SortOrder).Take(8).ToList();
            <footer class="inv-section inv-footer-gallery" id="moments">
                <h2>Our moments</h2>
                <div class="octagon-grid">
                    @foreach (var p in footerPhotos)
                    {
                        <div class="octagon-item">
                            <div class="octagon-frame">
                                <img src="@p.FilePath" alt="@p.Label" loading="lazy" />
                            </div>
                        </div>
                    }
                </div>
            </footer>
        }
    </div>

    <nav class="inv-dock" aria-label="Quick links">
        <a class="inv-dock-home" href="#home">Home</a>
        @if (Model.GalleryPhotos.Any())
        {
            <a class="inv-dock-gallery" href="#gallery">Gallery</a>
        }
        @if (Model.BankQrs.Any())
        {
            <a class="inv-dock-bank" href="#bank-qr">Bank QR</a>
        }
        @if ((Model.ShowMap && !string.IsNullOrWhiteSpace(mapQuery)) ||
             (!Model.ShowMap && wedding is not null && !string.IsNullOrWhiteSpace(wedding.VenueName)))
        {
            <a class="inv-dock-map" href="#map">Map</a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.MusicUrl))
        {
            <a class="inv-dock-music" href="#music">Music</a>
        }
        <a class="inv-dock-rsvp" href="#rsvp">RSVP</a>
    </nav>

    <script>
        (function () {
            function initCarousel(root) {
                var slideSel = root.getAttribute('data-slide') || '.qr-slide';
                var slides = Array.prototype.slice.call(root.querySelectorAll(slideSel));
                if (!slides.length) return;
                var prevBtn = root.querySelector('[data-carousel-prev]');
                var nextBtn = root.querySelector('[data-carousel-next]');
                var counter = root.querySelector('[data-carousel-counter]');
                var download = root.querySelector('[data-carousel-download]');
                var i = 0;

                function show(n) {
                    i = (n + slides.length) % slides.length;
                    slides.forEach(function (s, idx) {
                        s.classList.toggle('active', idx === i);
                    });
                    if (counter) counter.textContent = (i + 1) + ' / ' + slides.length;
                    var active = slides[i];
                    if (download && active) {
                        download.href = active.getAttribute('data-src') || download.href;
                        download.setAttribute('download', active.getAttribute('data-name') || 'download.png');
                    }
                    if (prevBtn) prevBtn.disabled = slides.length <= 1;
                    if (nextBtn) nextBtn.disabled = slides.length <= 1;
                }

                if (prevBtn) prevBtn.addEventListener('click', function () { show(i - 1); });
                if (nextBtn) nextBtn.addEventListener('click', function () { show(i + 1); });

                if (download) {
                    download.addEventListener('click', function (e) {
                        var active = slides[i];
                        if (!active) return;
                        var src = active.getAttribute('data-src');
                        var name = active.getAttribute('data-name') || 'download.png';
                        if (!src || (src.indexOf('http') === 0 && src.indexOf(location.origin) !== 0)) return;
                        e.preventDefault();
                        fetch(src).then(function (r) { return r.blob(); }).then(function (blob) {
                            var url = URL.createObjectURL(blob);
                            var a = document.createElement('a');
                            a.href = url;
                            a.download = name;
                            document.body.appendChild(a);
                            a.click();
                            a.remove();
                            URL.revokeObjectURL(url);
                        }).catch(function () {
                            window.open(src, '_blank');
                        });
                    });
                }

                show(0);
            }

            document.querySelectorAll('[data-carousel]').forEach(initCarousel);

            // Scroll reveal — animate in when entering viewport, out when leaving
            var revealEls = document.querySelectorAll('.inv-hero, .inv-section, .octagon-item');
            if (revealEls.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                        } else {
                            entry.target.classList.remove('is-visible');
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

                revealEls.forEach(function (el) { io.observe(el); });
            } else {
                revealEls.forEach(function (el) { el.classList.add('is-visible'); });
            }

            // Highlight dock link for the section in view
            var dock = document.querySelector('.inv-dock');
            if (dock) {
                var links = Array.prototype.slice.call(dock.querySelectorAll('a[href^="#"]'));
                var targets = links.map(function (a) {
                    return document.getElementById(a.getAttribute('href').slice(1));
                }).filter(Boolean);

                if (targets.length) {
                    var dockIo = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (!entry.isIntersecting) return;
                            var id = entry.target.id;
                            links.forEach(function (a) {
                                a.classList.toggle('is-active', a.getAttribute('href') === '#' + id);
                            });
                        });
                    }, { threshold: 0.35, rootMargin: '-20% 0px -45% 0px' });
                    targets.forEach(function (t) { dockIo.observe(t); });
                }
            }
        })();
    </script>
    <input type="hidden" data-web="@(wedding?.WebId ?? 0)" data-partner="@(Model.Slug ?? "")" />
</body>
</html>
