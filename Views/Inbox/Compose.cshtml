@model WeddingManagementSystem.Models.InboxMessage
@{
    ViewData["Title"] = "Compose";
}

<h1 class="page-title">Compose message</h1>
<div class="form-card">
    <form asp-action="Compose" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="FromName">To / From name</label>
            <input asp-for="FromName" required />
        </div>
        <div class="form-group">
            <label asp-for="FromEmail">Email</label>
            <input asp-for="FromEmail" type="email" />
        </div>
        <div class="form-group">
            <label asp-for="Subject"></label>
            <input asp-for="Subject" required />
        </div>
        <div class="form-group">
            <label asp-for="Body"></label>
            <textarea asp-for="Body" rows="5"></textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-gold">Save</button>
            <a class="btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
