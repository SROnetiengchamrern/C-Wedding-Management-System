@model WeddingManagementSystem.Models.InboxMessage
@{
    ViewData["Title"] = Model.Subject;
}

<a class="link-gold" asp-action="Index">← Back to inbox</a>
<div class="panel" style="margin-top:1rem;">
    <h1 class="page-title" style="margin-bottom:0.35rem;">@Model.Subject</h1>
    <p class="muted">From @Model.FromName @(string.IsNullOrWhiteSpace(Model.FromEmail) ? "" : $"<{Model.FromEmail}>") · @Model.ReceivedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
    <p style="white-space:pre-wrap;">@Model.Body</p>
</div>
