@model IEnumerable<WeddingManagementSystem.Controllers.GuestPartnerListItem>
@{
    ViewData["Title"] = "Guests / RSVP";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Guests / RSVP</h1>
        <p class="page-lead">Pick a couple to manage their guest list.</p>
    </div>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Web ID</th>
                <th>Couple</th>
                <th>Date</th>
                <th>Guests</th>
                <th>Accepted</th>
                <th>Pending</th>
                <th>Declined</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.WebId</td>
                <td><strong>@row.CoupleName</strong></td>
                <td>@row.WeddingDate.ToString("MMM d, yyyy")</td>
                <td>@row.GuestCount</td>
                <td>@row.Accepted</td>
                <td>@row.Pending</td>
                <td>@row.Declined</td>
                <td class="actions">
                    <a class="btn-outline btn-sm" asp-action="Manage" asp-route-weddingId="@row.WeddingId">Manage</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
