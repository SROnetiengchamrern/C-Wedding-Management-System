@model IEnumerable<WeddingManagementSystem.Controllers.GuestPartnerListItem>
@{
    ViewData["Title"] = "Guests / RSVP";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Guests / RSVP</h1>
        <p class="page-lead">Pick a couple to manage their guest list.</p>
    </div>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-id">Web ID</th>
                <th>Couple</th>
                <th class="col-date">Date</th>
                <th class="col-num">Guests</th>
                <th class="col-num">Accepted</th>
                <th class="col-num">Pending</th>
                <th class="col-num">Declined</th>
                <th class="col-actions"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td class="col-id">@row.WebId</td>
                <td class="col-couple"><strong>@row.CoupleName</strong></td>
                <td class="col-date">@row.DateDisplayShort</td>
                <td class="col-num">@row.GuestCount</td>
                <td class="col-num ok">@row.Accepted</td>
                <td class="col-num warn">@row.Pending</td>
                <td class="col-num bad">@row.Declined</td>
                <td class="col-actions">
                    <a class="btn-outline btn-sm" asp-action="Manage" asp-route-weddingId="@row.WeddingId">Manage</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
