@model WeddingManagementSystem.Models.Guest
@{
    ViewData["Title"] = "Add guest";
    var coupleName = (string)(ViewBag.CoupleName ?? "");
}

<div class="page-head">
    <div>
        <h1 class="page-title">Add guest</h1>
        <p class="page-lead">@coupleName</p>
    </div>
    <a class="btn-outline" asp-action="Manage" asp-route-weddingId="@Model.WeddingId">Back</a>
</div>

<div class="form-card" style="max-width:32rem;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="WeddingId" />
        <div class="form-group">
            <label asp-for="FullName">Full name</label>
            <input asp-for="FullName" required />
        </div>
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" />
        </div>
        <div class="form-group">
            <label asp-for="Phone"></label>
            <input asp-for="Phone" />
        </div>
        <div class="form-group">
            <label asp-for="Side"></label>
            <select asp-for="Side">
                <option value="Bride">Bride</option>
                <option value="Groom">Groom</option>
                <option value="Both">Both</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="PartySize">Party size</label>
            <input asp-for="PartySize" type="number" min="1" />
        </div>
        <div class="form-group">
            <label asp-for="RsvpStatus">RSVP</label>
            <select asp-for="RsvpStatus" asp-items="Html.GetEnumSelectList<WeddingManagementSystem.Models.RsvpStatus>()"></select>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-gold">Save</button>
            <a class="btn-outline" asp-action="Manage" asp-route-weddingId="@Model.WeddingId">Cancel</a>
        </div>
    </form>
</div>
