@model List<WeddingManagementSystem.ViewModels.GiftPartnerListItem>
@{
    ViewData["Title"] = "Gift Money";
    var n = 1;
}

<div class="toolbar">
    <div>
        <h1 class="page-title">Gift Money</h1>
        <p class="muted" style="margin:0;">Choose a couple to manage their wedding gift / money list.</p>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="info-banner">@ok</div>
}

<div class="wedding-site-list">
@foreach (var w in Model)
{
    <a class="wedding-site-row wedding-site-link" asp-action="Manage" asp-route-weddingId="@w.WeddingId">
        <span class="wedding-site-num">@n.</span>
        <span class="wedding-site-main">
            <strong>@w.CoupleName</strong>
            <span class="muted sm-text">
                @w.DateDisplayShort
                @if (!string.IsNullOrWhiteSpace(w.VenueName))
                {
                    <text> · @w.VenueName</text>
                }
            </span>
            <span class="muted sm-text">web_id: @w.WebId</span>
            <span class="muted sm-text">
                Guests @w.GiftCount · KHR @w.TotalKhr.ToString("N0") ៛ · USD @w.TotalUsd.ToString("N0") $
            </span>
        </span>
        <span class="wedding-site-arrow">Open →</span>
    </a>
    n++;
}
</div>

@if (!Model.Any())
{
    <div class="invite-admin-card" style="margin-top:1rem;">
        <p class="muted" style="margin:0;">No partners yet. Add a couple under Wedding Website first.</p>
    </div>
}
