@model List<WeddingManagementSystem.Models.Document>
@{
    ViewData["Title"] = "Documents";
}

<div class="toolbar">
    <h1 class="page-title">Documents</h1>
    <a class="btn-gold" asp-action="Create">Add document</a>
</div>

<div class="panel">
    <ul class="doc-list">
        @foreach (var d in Model)
        {
            <li>
                <span class="doc-icon">PDF</span>
                <div style="flex:1;">
                    <strong>@d.FileName</strong>
                    <div class="muted sm-text">@d.UploadedAt.ToLocalTime().ToString("MMM d, yyyy") · @(d.Category ?? "File")</div>
                </div>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@d.Id" />
                    <button type="submit" class="btn-ghost">Remove</button>
                </form>
            </li>
        }
    </ul>
</div>
