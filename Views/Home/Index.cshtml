@model WeddingManagementSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Overview";
}

<div class="dash-header">
    <div>
        <p class="eyebrow">Wedding Admin</p>
        <h1 class="couple-name">Overview</h1>
        <p class="wedding-meta">Couples, invite sites, gift money, and RSVP at a glance.</p>
    </div>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
        <a class="btn-outline" asp-controller="Website" asp-action="Index">Wedding Website</a>
        <a class="btn-gold" asp-controller="Gifts" asp-action="Index">Gift Money</a>
    </div>
</div>

<div class="info-banner">
    <span class="info-icon">i</span>
    Choose a couple below to edit their invite site or gift list. Public guests use each couple’s published link.
</div>

<div class="stat-row">
    <div class="stat-card">
        <div class="stat-label">Couples</div>
        <div class="stat-value">@Model.CouplesCount</div>
        <div class="stat-sub">web_id partners</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Invite sites</div>
        <div class="stat-value">@Model.PublishedSites<span class="stat-of">/@Model.CouplesCount</span></div>
        <div class="stat-sub">@Model.DraftSites draft · @Model.PublishedSites published</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Gift money</div>
        <div class="stat-value">@Model.GiftGuests</div>
        <div class="stat-sub">KHR @Model.GiftKhr.ToString("N0") ៛ · USD @Model.GiftUsd.ToString("N0") $</div>
    </div>
</div>

<div class="status-row">
    <div class="status-chip ok">
        <span class="chip-icon">✓</span>
        <div>
            <strong>@Model.RsvpAccepted Accepted</strong>
            <span>RSVP joyfully accepts</span>
        </div>
    </div>
    <div class="status-chip warn">
        <span class="chip-icon">×</span>
        <div>
            <strong>@Model.RsvpDeclined Declined</strong>
            <span>RSVP declines</span>
        </div>
    </div>
    <div class="status-chip">
        <span class="chip-icon">?</span>
        <div>
            <strong>@Model.RsvpMaybe Maybe</strong>
            <span>not sure yet</span>
        </div>
    </div>
    <div class="status-chip">
        <span class="chip-icon">✉</span>
        <div>
            <strong>@Model.RsvpTotal Total</strong>
            <span>website RSVP replies</span>
        </div>
    </div>
</div>

<section class="panel" style="margin-top:1rem;">
    <div class="panel-head">
        <h2>All couples</h2>
        <a class="link-gold" asp-controller="Website" asp-action="Index">Manage websites →</a>
    </div>

    <div class="wedding-site-list" style="max-width:none;">
    @foreach (var c in Model.Couples)
    {
        <div class="wedding-site-row">
            <a class="wedding-site-link" asp-controller="Website" asp-action="Edit" asp-route-weddingId="@c.WeddingId">
                <span class="wedding-site-num">@c.WebId</span>
                <span class="wedding-site-main">
                    <strong>@c.CoupleName</strong>
                    <span class="muted sm-text">
                        @c.WeddingDate.ToString("MMM d, yyyy")
                        @if (!string.IsNullOrWhiteSpace(c.VenueName))
                        {
                            <text> · @c.VenueName</text>
                        }
                        · @c.DaysLeft days left
                    </span>
                    <span class="muted sm-text">
                        @if (!string.IsNullOrWhiteSpace(c.Slug))
                        {
                            <text>/w/@c.Slug · </text>
                        }
                        Gifts @c.GiftCount · KHR @c.GiftKhr.ToString("N0") · USD @c.GiftUsd.ToString("N0") · RSVP @c.RsvpCount
                    </span>
                </span>
            </a>
            <span class="wedding-site-badge @(c.IsPublished ? "live" : "draft")">@(c.IsPublished ? "Published" : "Draft")</span>
            <a class="wedding-site-arrow" asp-controller="Gifts" asp-action="Manage" asp-route-weddingId="@c.WeddingId">Gifts →</a>
        </div>
    }
    </div>
</section>

<section class="grid-2" style="margin-top:1rem;">
    <div class="mini-panel">
        <h3>Wedding Website</h3>
        <p class="muted">Themes, gallery, bank QR, map, music, and public invite links.</p>
        <a class="btn-outline" asp-controller="Website" asp-action="Index">Open websites</a>
    </div>
    <div class="mini-panel">
        <h3>Gift Money</h3>
        <p class="muted">Enter guest gifts in English or Khmer. Export PDF / XLSX per couple.</p>
        <a class="btn-outline" asp-controller="Gifts" asp-action="Index">Open gift money</a>
    </div>
</section>
