@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Wedding Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

        <header class="mobile-topbar">
            <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="appSidebar">
                <span></span><span></span><span></span>
            </button>
            <div class="mobile-brand">
                <div class="brand-mark">W</div>
                <span>Wedding Admin</span>
            </div>
        </header>

        <aside class="sidebar" id="appSidebar">
            <div class="brand">
                <div class="brand-mark">W</div>
                <div class="brand-text">
                    <div class="brand-name">Wedding Admin</div>
                    <span class="demo-tag">DEMO</span>
                </div>
                <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close menu">×</button>
            </div>

            <nav class="side-nav">
                <a class="@(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg></span>
                    <span class="nav-label">Overview</span>
                </a>
                <a class="@(ctrl == "Website" ? "active" : "")" asp-controller="Website" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M2 12h20M12 2a14 14 0 0 1 0 20M12 2a14 14 0 0 0 0 20"/></svg></span>
                    <span class="nav-label">Wedding Website</span>
                </a>
                <a class="@(ctrl == "Gifts" ? "active" : "")" asp-controller="Gifts" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20 12v8H4v-8"/><path d="M2 7h20v5H2z"/><path d="M12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
                    <span class="nav-label">Gift Money</span>
                </a>
                <a class="@(ctrl == "Guests" ? "active" : "")" asp-controller="Guests" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                    <span class="nav-label">Guests / RSVP</span>
                </a>
                <a class="@(ctrl == "WeddingDetails" ? "active" : "")" asp-controller="WeddingDetails" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20.8 4.6a5 5 0 0 0-7.1 0L12 6.3l-1.7-1.7a5 5 0 0 0-7.1 7.1L12 20.3l8.8-8.6a5 5 0 0 0 0-7.1z"/></svg></span>
                    <span class="nav-label">Couples</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="footer-user muted sm-text">@User.Identity.Name</div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="footer-link logout-btn">
                            <span class="nav-icon sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg></span>
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a class="footer-link" asp-controller="Account" asp-action="Login">Sign in</a>
                }
            </div>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
