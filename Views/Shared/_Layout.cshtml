@inject WeddingManagementSystem.Data.ApplicationDbContext Db
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var unread = Db.InboxMessages.Count(m => !m.IsRead);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Wedding Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

        <header class="mobile-topbar">
            <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="appSidebar">
                <span></span><span></span><span></span>
            </button>
            <div class="mobile-brand">
                <div class="brand-mark">W</div>
                <span>Wedding Admin</span>
            </div>
        </header>

        <aside class="sidebar" id="appSidebar">
            <div class="brand">
                <div class="brand-mark">W</div>
                <div class="brand-text">
                    <div class="brand-name">Wedding Admin</div>
                    <span class="demo-tag">DEMO</span>
                </div>
                <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close menu">×</button>
            </div>

            <nav class="side-nav">
                <a class="@(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg></span>
                    <span class="nav-label">Overview</span>
                </a>
                <a class="@(ctrl == "Tasks" ? "active" : "")" asp-controller="Tasks" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
                    <span class="nav-label">Tasks</span>
                </a>
                <a class="@(ctrl == "Timeline" ? "active" : "")" asp-controller="Timeline" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 6h16M4 12h10M4 18h14"/></svg></span>
                    <span class="nav-label">Timeline</span>
                </a>
                <a class="@(ctrl == "Budget" ? "active" : "")" asp-controller="Budget" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5c.6-1 1.7-1.5 2.8-1.5 1.5 0 2.7.9 2.7 2.3S13.8 12.5 12 12.5 9 13.4 9 14.8c0 1.4 1.3 2.2 2.8 2.2 1.1 0 2.1-.5 2.7-1.5"/></svg></span>
                    <span class="nav-label">Budget</span>
                </a>
                <a class="@(ctrl == "WeddingDetails" ? "active" : "")" asp-controller="WeddingDetails" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20.8 4.6a5 5 0 0 0-7.1 0L12 6.3l-1.7-1.7a5 5 0 0 0-7.1 7.1L12 20.3l8.8-8.6a5 5 0 0 0 0-7.1z"/></svg></span>
                    <span class="nav-label">Wedding Details</span>
                </a>
                <a class="@(ctrl == "Agreements" ? "active" : "")" asp-controller="Agreements" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg></span>
                    <span class="nav-label">Agreements</span>
                </a>
                <a class="@(ctrl == "Documents" ? "active" : "")" asp-controller="Documents" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg></span>
                    <span class="nav-label">Documents</span>
                </a>
                <a class="@(ctrl == "Inbox" ? "active" : "")" asp-controller="Inbox" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg></span>
                    <span class="nav-label">Inbox</span>
                    @if (unread > 0)
                    {
                        <span class="nav-badge">@unread</span>
                    }
                </a>
                <a class="@(ctrl == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 4h16v4H4zM6 8v12M18 8v12M4 20h16"/><path d="M9 12h6"/></svg></span>
                    <span class="nav-label">Menu</span>
                </a>
                <a class="@(ctrl == "Delivery" ? "active" : "")" asp-controller="Delivery" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 7h13l5 5v5H3z"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/></svg></span>
                    <span class="nav-label">Delivery</span>
                </a>
                <a class="@(ctrl == "Guests" ? "active" : "")" asp-controller="Guests" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                    <span class="nav-label">Guest Management</span>
                </a>
                <a class="@(ctrl == "Gifts" ? "active" : "")" asp-controller="Gifts" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20 12v8H4v-8"/><path d="M2 7h20v5H2z"/><path d="M12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
                    <span class="nav-label">Gift Money</span>
                </a>
                <a class="@(ctrl == "Website" ? "active" : "")" asp-controller="Website" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M2 12h20M12 2a14 14 0 0 1 0 20M12 2a14 14 0 0 0 0 20"/></svg></span>
                    <span class="nav-label">Wedding Website</span>
                </a>
                <a class="@(ctrl == "Schedule" ? "active" : "")" asp-controller="Schedule" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>
                    <span class="nav-label">Day of Schedule</span>
                </a>
                <a class="@(ctrl == "Imported" ? "active" : "")" asp-controller="Imported" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/></svg></span>
                    <span class="nav-label">Imported</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <a class="btn-start" asp-controller="Tasks" asp-action="Create">Start now</a>
                <a class="footer-link" asp-controller="Settings" asp-action="Index">
                    <span class="nav-icon sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg></span>
                    Settings
                </a>
                <a class="footer-link" asp-controller="WeddingDetails" asp-action="Index">
                    <span class="nav-icon sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
                    @(User.Identity?.IsAuthenticated == true ? (User.Identity.Name ?? "My Account") : "My Account")
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="footer-link logout-btn">
                            <span class="nav-icon sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg></span>
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a class="footer-link" asp-controller="Account" asp-action="Login">Sign in</a>
                }
                <a class="footer-link" href="mailto:support@example.com">
                    <span class="nav-icon sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M12 16v-1a3 3 0 1 0-3-3"/><circle cx="12" cy="18" r=".8" fill="currentColor"/></svg></span>
                    Help
                </a>
            </div>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
